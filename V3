def write_limb_debug(scriptOp):
    """Dump each limb's raw solved angle and final written angle (degrees) to a
    'LIMBS' Table DAT, so you can read the actual numbers instead of guessing."""
    d = op(LIMBS_DAT_NAME)
    if d is None:
        try:
            d = scriptOp.parent().create(tableDAT, LIMBS_DAT_NAME)
            d.nodeX, d.nodeY = scriptOp.nodeX + 200, scriptOp.nodeY - 320
        except Exception:
            return
    d.clear()
    d.appendRow(['bone', 'in_rx', 'in_ry', 'in_rz', 'out_rx', 'out_ry', 'out_rz'])
    shown = [b for b in _LIMB_ORDER if b in _limb_debug]
    shown += [b for b in _limb_debug if b not in _LIMB_ORDER]
    for b in shown:
        i0, i1, i2, o0, o1, o2 = _limb_debug[b]
        d.appendRow([b, f'{i0:.1f}', f'{i1:.1f}', f'{i2:.1f}',
