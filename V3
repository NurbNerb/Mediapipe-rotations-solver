    if not par_name: return 'XYZ'
    try: return getattr(scriptOp.par, par_name).eval()
    except: return 'XYZ'
def build_chan_map(scriptOp):
    return {ch.name: i for i,ch in enumerate(scriptOp.chans())}

def _arm_pole(bone, upper_dir, fore_dir):
    """
    Bend-plane normal for an arm = cross(upper, forearm).  This is the pole
    that pins the bone's TWIST (roll) — the DOF that joint positions alone
    can't determine (swing/twist decomposition).  When the arm is nearly
    straight the plane is undefined, so we reuse the last good pole; and we
    sign-lock to the previous frame so the pole can't flip to the other side
    as the arm sweeps through full extension (an elbow only bends one way).
    """
    prev = _arm_pole_prev.get(bone)
    n = vec_cross(upper_dir, fore_dir)
    if vec_len(n) < 0.12:                      # arm ~straight → plane undefined
        if prev is not None:
            return prev
        n = vec_cross(upper_dir, [0, 0, 1])    # first-frame fallback
        if vec_len(n) < 0.12:
            n = vec_cross(upper_dir, [0, 1, 0])
    n = vec_norm(n)
    if prev is not None and vec_dot(n, prev) < 0.0:   # keep pole on one side
        n = [-n[0], -n[1], -n[2]]
    _arm_pole_prev[bone] = n
    return n
    return order

def rebuild_channels(scriptOp):
    current_rig = scriptOp.par.Rigtype.eval()
    bone_map = RIG_MAPPINGS.get(current_rig, RIG_MAPPINGS['Mixamo'])
    multi = bool(scriptOp.par.Multiperson.eval()) if hasattr(scriptOp.par, 'Multiperson') else False
    maxp  = max(1, min(5, int(scriptOp.par.Maxpeople.eval()))) if hasattr(scriptOp.par, 'Maxpeople') else 1
    limbxyz = bool(scriptOp.par.Limbxyz.eval()) if hasattr(scriptOp.par, 'Limbxyz') else False
    scriptOp.clear()
    tags = [f'p{i}' for i in range(1, maxp + 1)] if multi else ['']
    for tag in tags:
        pfx = f'{tag}_' if tag else ''
        for generic_bone in GENERIC_BONES:
            rig_bone = bone_map.get(generic_bone, generic_bone)
            if generic_bone == 'Hips':
                for axis in ('tx','ty','tz','rx','ry','rz'):
                    scriptOp.appendChan(f'{pfx}{rig_bone}:{axis}')
            else:
                for axis in ('rx','ry','rz'):
                    scriptOp.appendChan(f'{pfx}{rig_bone}:{axis}')
                if limbxyz and generic_bone in LIMB_XYZ_MAP:
                    for axis in ('tx','ty','tz'):
                        scriptOp.appendChan(f'{pfx}{rig_bone}:{axis}')
        if multi:
            scriptOp.appendChan(f'{tag}_present')   # 1 = solved this frame, 0 = absent
    scriptOp.appendChan('quality')
    scriptOp.appendChan('error')
    scriptOp.appendChan('animmode')
    scriptOp.storage['chan_map']       = build_chan_map(scriptOp)
    scriptOp.storage['prev_rig_type']  = current_rig
    scriptOp.storage['prev_multi']     = multi
    scriptOp.storage['prev_maxp']      = maxp
    scriptOp.storage['prev_limbxyz']   = limbxyz
    load_rig_bind_offsets(scriptOp, current_rig)

