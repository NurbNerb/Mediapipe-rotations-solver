def _snapshot_current_pars(scriptOp):
    """Capture every non-pulse custom par's current value -> {name: value}."""
    out = {}
    for _p in scriptOp.customPars:
        if getattr(_p, 'isPulse', False):
            continue
        try:
            out[_p.name] = _p.eval()
        except Exception:
            try:
                out[_p.name] = _p.val
            except Exception:
                pass
    return out

def _apply_param_snapshot(scriptOp, snapshot):
    """Write a {name: value} snapshot back onto matching custom pars."""
    for name, val in snapshot.items():
        if not hasattr(scriptOp.par, name):
            continue
        try:
            getattr(scriptOp.par, name).val = val
        except Exception:
            pass


