            getattr(scriptOp.par, f'{prefix}rx').val = bone_off[0]
            getattr(scriptOp.par, f'{prefix}ry').val = bone_off[1]
            getattr(scriptOp.par, f'{prefix}rz').val = bone_off[2]
        except: pass

def get_coord_flips(scriptOp):
