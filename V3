# ─────────────────────────────────────────────────────────────────────────────
#  Per-limb One Euro overrides (arms / legs) — dedicated jitter control
#  When a group's override toggle is ON, its bones use an explicit One Euro
#  min-cutoff (Hz; lower = smoother at rest = less jitter) and beta (speed
#  coefficient; higher = opens up faster in motion = less lag) instead of the
#  Arm/Rotation smoothing knob's derived cutoff. OFF = unchanged legacy behavior.
#  Covers BOTH the FK and the Leg-IK output paths (both write via set_rotation).
# ─────────────────────────────────────────────────────────────────────────────
ARM_EURO_BONES = {'LeftArm', 'RightArm', 'LeftForeArm', 'RightForeArm'}
LEG_EURO_BONES = {'LeftUpLeg', 'LeftLeg', 'LeftFoot', 'LeftToe',
                  'RightUpLeg', 'RightLeg', 'RightFoot', 'RightToe'}

def _euro_override(scriptOp, generic_bone):
    """(min_cutoff, beta) One Euro overrides for arm/leg bones when the group's
    override toggle is on; (None, None) otherwise = legacy smooth-factor mapping."""
    if generic_bone in ARM_EURO_BONES:
        if hasattr(scriptOp.par, 'Armeuro') and scriptOp.par.Armeuro.eval():
            mco = scriptOp.par.Armmincutoff.eval() if hasattr(scriptOp.par, 'Armmincutoff') else 1.0
            bta = scriptOp.par.Armbeta.eval()      if hasattr(scriptOp.par, 'Armbeta')      else EURO_BETA
            return mco, bta
    elif generic_bone in LEG_EURO_BONES:
        if hasattr(scriptOp.par, 'Legeuro') and scriptOp.par.Legeuro.eval():
            mco = scriptOp.par.Legmincutoff.eval() if hasattr(scriptOp.par, 'Legmincutoff') else 1.0
            bta = scriptOp.par.Legbeta.eval()      if hasattr(scriptOp.par, 'Legbeta')      else EURO_BETA
            return mco, bta
    return None, None


def set_rotation(scriptOp, generic_bone, rx, ry, rz, smooth_factor):
    if not hasattr(scriptOp.par, 'Rigtype'): return
    rig_type = scriptOp.par.Rigtype.eval()
    bone_map = RIG_MAPPINGS.get(rig_type, RIG_MAPPINGS['Mixamo'])
    rig_bone = bone_map.get(generic_bone, generic_bone)

    dbg_in = (rx, ry, rz)   # raw solved angle, before amp/flip/clamp/cal

    if generic_bone in ('LeftArm', 'RightArm'):
        amp = scriptOp.par.Armamp.eval() if hasattr(scriptOp.par,'Armamp') else 1.0
        rx,ry,rz = rx*amp, ry*amp, rz*amp
    elif generic_bone in ('LeftForeArm', 'RightForeArm'):
        amp = scriptOp.par.Forearmamp.eval() if hasattr(scriptOp.par,'Forearmamp') else 1.0
        rx,ry,rz = rx*amp, ry*amp, rz*amp

    if generic_bone in ARM_AXISFLIP_PARAMS:
        sx,sy,sz = get_arm_axisflips(scriptOp, generic_bone)
        rx,ry,rz = rx*sx, ry*sy, rz*sz

    rx,ry,rz = clamp_rotation(generic_bone, rx, ry, rz)

    # ONE global decompose order for EVERY bone (live-mocap only; no calibration,
    # no FBX read). This is the split order set_rotation writes rx/ry/rz in — it
    # MUST partner the rord your downstream Bone COMPs use. Cycle Outputrotorder
    # against a COMBINED pose to lock it; a single-axis pose decodes the same in
    # every order and will fool you.
    rot_order = scriptOp.par.Outputrotorder.eval() if hasattr(scriptOp.par, 'Outputrotorder') else 'XYZ'

    # Guard the value entering the filter — a NaN here would latch into the
    # bone's smoothing state and poison every later frame (the vanishing limb).
    if not _finite(rx, ry, rz):
        _heal_bone(generic_bone)
        log(f'healed {generic_bone} (bad input)', 'DEBUG', scriptOp)
        return

    _euro_mco, _euro_bta = _euro_override(scriptOp, generic_bone)
    s_rx,s_ry,s_rz  = smooth_quat(generic_bone, euler_to_quat(rx,ry,rz), smooth_factor, _euro_mco, _euro_bta)

    # q_dec = the final LOCAL quat this bone writes (before euler decomposition).
    # SKELETON mode with Skelraw on -> write the smoothed quat straight (your
    # skeleton is already in-space; you offset downstream). Otherwise apply the
    # RIG_OFFSETS bind offset as a CONJUGATION (change of basis), not a pre-
    # multiply — a static pre-multiply can't remap a dynamic delta and bleeds
    # axes at range. Offsets seed from RIG_OFFSETS; tune per bone on Offsets page.
    if _skel_bypass_offset:
        q_dec = euler_to_quat(s_rx,s_ry,s_rz)
    else:
        bx,by,bz  = get_bind_offset(scriptOp, generic_bone)
        q_base    = euler_to_quat(s_rx,s_ry,s_rz)
        q_bind    = euler_to_quat(bx,by,bz)
        q_dec     = quat_mult(quat_mult(q_bind, q_base), quat_inv(q_bind))

    f_rx,f_ry,f_rz = quat_to_euler_order(q_dec, rot_order)

    # Guard the value leaving the pipeline — if anything went non-finite,
    # skip the write and heal so the bone recovers on the next good frame
    # instead of getting stuck (no more manual CHOP reset).
    if not _finite(f_rx, f_ry, f_rz):
        _heal_bone(generic_bone)
        log(f'healed {generic_bone} (bad output)', 'DEBUG', scriptOp)
        return

    # v2.9.14: stash the exact written LOCAL quat + its rot-order so a later
    # placement offset (place_offset_pair) can rotate this bone and cancel the
    # rotation on its child using the SAME quat that hit the channels.
    _bone_out_q[generic_bone] = (list(q_dec), rot_order)

    _limb_debug[generic_bone] = (dbg_in[0], dbg_in[1], dbg_in[2],
                                 clamp_angle(f_rx), clamp_angle(f_ry), clamp_angle(f_rz))

    chan_map = scriptOp.storage.get('chan_map', {})
    for ax,val in zip(('rx','ry','rz'), (f_rx,f_ry,f_rz)):
        c_name = f'{_active_person_prefix}{rig_bone}:{ax}'
        if c_name in chan_map:
            scriptOp[chan_map[c_name]][0] = clamp_angle(val)

# ── v2.9.14: exact parent-offset / child-cancel placement ────────────────────
def place_offset_pair(scriptOp, parent_bone, child_bone, off_euler):
    """Physically rotate `parent_bone` by `off_euler` (in the parent's own local
    frame) and CANCEL that rotation on `child_bone`, so the child's WORLD
    orientation — and everything below it — is unchanged.

    The FBX parents the arm UNDER the shoulder, so  world_arm = world_sh · R_arm.
    Post-multiply the shoulder by Q  →  world_sh · Q, pre-multiply the arm by
    Q⁻¹  →  Q⁻¹ · R_arm, and the pair telescopes:
        world_sh · Q · Q⁻¹ · R_arm = world_sh · R_arm        (arm unchanged)

    Operates on the EXACT quats set_rotation wrote (post smoothing / calibration
    / rot-order / external reinforce), so the cancel is algebraically exact at
    ANY angle — Y±90 included. Must run AFTER both bones have been solved this
    cook. All-zero offset → early-out, bit-identical to not calling it."""
    if all(abs(a) < 1e-9 for a in off_euler):
        return
    p = _bone_out_q.get(parent_bone)
    c = _bone_out_q.get(child_bone)
    if p is None or c is None:          # a bone didn't solve this frame → skip
        return

    q_off = euler_to_quat(off_euler[0], off_euler[1], off_euler[2])
    q_par = quat_mult(p[0], q_off)              # parent: offset in its local frame
    q_chi = quat_mult(quat_inv(q_off), c[0])    # child : exact inverse cancel

    px, py, pz = quat_to_euler_order(q_par, p[1])
    cx, cy, cz = quat_to_euler_order(q_chi, c[1])
    if not (_finite(px, py, pz) and _finite(cx, cy, cz)):
        return

    rig_type = scriptOp.par.Rigtype.eval()
    bone_map = RIG_MAPPINGS.get(rig_type, RIG_MAPPINGS['Mixamo'])
    chan_map = scriptOp.storage.get('chan_map', {})
    for bone, vals in ((parent_bone, (px, py, pz)), (child_bone, (cx, cy, cz))):
        rig_bone = bone_map.get(bone, bone)
        for ax, val in zip(('rx','ry','rz'), vals):
            c_name = f'{_active_person_prefix}{rig_bone}:{ax}'
            if c_name in chan_map:
                scriptOp[chan_map[c_name]][0] = clamp_angle(val)

    # keep the stash current in case something offsets these bones again
    _bone_out_q[parent_bone] = (list(q_par), p[1])
    _bone_out_q[child_bone]  = (list(q_chi), c[1])

# ── v2.9.14: FIXED shoulder — pin roll, keep arm exactly ─────────────────────
def place_shoulder_fixed(scriptOp, shoulder_bone, arm_bone, roll_euler):
    """Stop letting MediaPipe drive the shoulder. MediaPipe has NO clavicle, so
    the shoulder solve is noise (it reads the upper-arm direction and twists the
    clavicle to match) — that's the 'shoulders rolled too far back' you're
    seeing. This PINS the shoulder to a fixed local roll and re-solves the arm so
    its WORLD orientation is byte-for-byte what it is right now.

        shoulder_final = R_fix                       (a clean, static roll)
        arm_final      = R_fix⁻¹ · R_sh_solved · A   (keeps arm world put)

    FBX arm world = W_s2 · R_fix · R_fix⁻¹ · R_sh_solved · A
                  = W_s2 · R_sh_solved · A           (the arm you have now)

    Uses the quats set_rotation already stashed this cook, so the arm doesn't
    move at any body pose — the shoulder just stops wobbling. Runs AFTER §4/§5."""
    p = _bone_out_q.get(shoulder_bone)   # (R_sh_solved, rot_order)
    c = _bone_out_q.get(arm_bone)        # (A = chest-relative arm, rot_order)
    if p is None or c is None:
        return

    q_fix = euler_to_quat(roll_euler[0], roll_euler[1], roll_euler[2])
    q_arm = quat_mult(quat_inv(q_fix), quat_mult(p[0], c[0]))   # inv(fix)·R_sh·A

    sx, sy, sz = quat_to_euler_order(q_fix, p[1])
    ax, ay, az = quat_to_euler_order(q_arm, c[1])
    if not (_finite(sx, sy, sz) and _finite(ax, ay, az)):
        return

    rig_type = scriptOp.par.Rigtype.eval()
    bone_map = RIG_MAPPINGS.get(rig_type, RIG_MAPPINGS['Mixamo'])
    chan_map = scriptOp.storage.get('chan_map', {})
    for bone, vals in ((shoulder_bone, (sx, sy, sz)), (arm_bone, (ax, ay, az))):
        rig_bone = bone_map.get(bone, bone)
        for ax_name, val in zip(('rx','ry','rz'), vals):
            c_name = f'{_active_person_prefix}{rig_bone}:{ax_name}'
            if c_name in chan_map:
                scriptOp[chan_map[c_name]][0] = clamp_angle(val)

    _bone_out_q[shoulder_bone] = (list(q_fix), p[1])
    _bone_out_q[arm_bone]      = (list(q_arm), c[1])

def add_to_channel(scriptOp, generic_bone, axis, deg):
    """Add `deg` straight onto a bone's output channel AFTER set_rotation, past
    all smoothing/offset/decomposition. Nothing downstream in the script can
    eat it. (Legacy helper; the shoulder placement now goes through
    place_offset_pair, which cancels on the arm exactly.)"""
    if abs(deg) < 1e-9:
        return
    rig_type = scriptOp.par.Rigtype.eval()
    bone_map = RIG_MAPPINGS.get(rig_type, RIG_MAPPINGS['Mixamo'])
    rig_bone = bone_map.get(generic_bone, generic_bone)
    chan_map = scriptOp.storage.get('chan_map', {})
    c_name = f'{_active_person_prefix}{rig_bone}:{axis}'
    if c_name in chan_map:
        i = chan_map[c_name]
        scriptOp[i][0] = clamp_angle(scriptOp[i][0] + deg)

def set_channel_hard(scriptOp, generic_bone, axis, deg):
