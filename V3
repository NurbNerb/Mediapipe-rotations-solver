    try:
        sx = -1 if getattr(scriptOp.par, params[0]).eval() else 1
        sy = -1 if getattr(scriptOp.par, params[1]).eval() else 1
        sz = -1 if getattr(scriptOp.par, params[2]).eval() else 1
