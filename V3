def onPulse(par):
    global prev_rot, rotation_history, _root_pos_prev
    global _stationary_n, _root_locked                       # v2.9.11
    scriptOp = par.owner

    if par.name in ('Reset','Resetoptimal','Loadrigdefaults'):
        prev_rot.clear(); rotation_history.clear(); _euro_state.clear()
        _root_pos_prev = None
        _arm_pole_prev.clear()
        _gate_prev.clear()                                   # v2.9.11
        _ankle_prev.clear(); _stationary_n = 0; _root_locked = None  # v2.9.11
        reset_leg_ik()                                       # v2.9.12
        reset_occlusion()                                    # v2.9.13
        reset_facing()                                       # back-facing state
        reset_lookahead()                                    # v2.9.17
        _bone_out_q.clear()                                  # v2.9.14
        _person_states.clear()
        if par.name == 'Reset':
            reset_bone_lengths()                             # v2.9.21
            _bone_conf.clear()                               # v2.9.21
            log('filters reset (all bones healed)', 'INFO', scriptOp)
        if par.name == 'Resetoptimal':
            for name,val in OPTIMAL_SETTINGS.items():
                if hasattr(scriptOp.par, name): scriptOp.par[name].val = val
        if par.name == 'Loadrigdefaults':
            load_rig_bind_offsets(scriptOp)

    if par.name == 'Recapturelengths':                       # v2.9.21
        reset_bone_lengths()
        log('bone lengths cleared - re-learning', 'INFO', scriptOp)

    if par.name == 'Savedefaults':
        # Snapshot ALL current (non-pulse) settings as the new working defaults.
        scriptOp.storage['par_defaults'] = _snapshot_current_pars(scriptOp)
        log('current settings saved as defaults', 'INFO', scriptOp)

    if par.name in ('Resetdefaults', 'Resetfactory'):        # v2.9.23
        # Restore every param from the chosen snapshot (saved defaults, or the
        # immutable factory built-ins), then clear all internal filter/learning
        # state and rebuild channels so the module returns to a clean slate.
        _key = 'par_factory' if par.name == 'Resetfactory' else 'par_defaults'
        _apply_param_snapshot(scriptOp, scriptOp.storage.get(_key, {}))
        prev_rot.clear(); rotation_history.clear(); _euro_state.clear()
        _root_pos_prev = None
        _arm_pole_prev.clear()
        _gate_prev.clear()
        _ankle_prev.clear(); _stationary_n = 0; _root_locked = None
        reset_leg_ik()
        reset_occlusion()
        reset_facing()
        reset_lookahead()
        _bone_out_q.clear()
        _person_states.clear()
        reset_bone_lengths()
        _bone_conf.clear()
        rebuild_channels(scriptOp)
        log(f'params reset to {"factory" if par.name == "Resetfactory" else "saved"} '
            f'defaults + filters cleared', 'INFO', scriptOp)


def onCook(scriptOp):
    global _log_cook
    _log_cook += 1
    try:
        _cook(scriptOp)
    except Exception as e:
        import traceback
        log(f'{type(e).__name__}: {e}', 'ERROR', scriptOp)
        try:
            log(traceback.format_exc().strip().splitlines()[-1], 'DEBUG', scriptOp)
        except Exception:
            pass


def _cook(scriptOp):
    global _skel_bypass_offset, _conf_smooth_floor, _active_person_prefix
    _skel_bypass_offset = False            # v2.9.18: default off; skeleton branch sets it

    if not hasattr(scriptOp.par,'Systemenabled') or not scriptOp.par.Systemenabled.eval():
        return

    _limb_debug.clear()
    _bone_out_q.clear()          # v2.9.14: fresh per-cook stash of written quats

    current_rig = scriptOp.par.Rigtype.eval()
    _multi_now = bool(scriptOp.par.Multiperson.eval()) if hasattr(scriptOp.par, 'Multiperson') else False
    _maxp_now  = max(1, min(5, int(scriptOp.par.Maxpeople.eval()))) if hasattr(scriptOp.par, 'Maxpeople') else 1
    if (current_rig != scriptOp.storage.get('prev_rig_type', None)
            or _multi_now != scriptOp.storage.get('prev_multi', None)
            or _maxp_now  != scriptOp.storage.get('prev_maxp', None)
            or (bool(scriptOp.par.Limbxyz.eval()) if hasattr(scriptOp.par,'Limbxyz') else False)
               != scriptOp.storage.get('prev_limbxyz', None)):
        rebuild_channels(scriptOp)
        log(f'channels rebuilt (rig={current_rig} multi={_multi_now} maxp={_maxp_now})', 'INFO', scriptOp)

    if 'chan_map' not in scriptOp.storage or not scriptOp.storage['chan_map']:
        rebuild_channels(scriptOp)

    mode = scriptOp.par.Mode.eval()

    if mode == 'ANIM':
        if len(scriptOp.inputs) < 3 or scriptOp.inputs[2] is None: return
        anim_in  = scriptOp.inputs[2]
        chan_map  = scriptOp.storage.get('chan_map', {})
        rev_map   = _REVERSE_MAPS.get(current_rig, {})
        for ch in anim_in.chans():
            base_name    = ch.name.split(':')[0] if ':' in ch.name else ch.name
            axis         = ch.name.split(':')[-1] if ':' in ch.name else 'rx'
            generic_bone = rev_map.get(base_name, base_name)
            grid_bone    = get_rig_bone(scriptOp, generic_bone, current_rig)
            target_chan  = f'{grid_bone}:{axis}'
            if target_chan in chan_map:
                scriptOp[chan_map[target_chan]][0] = ch[0]
        if 'animmode' in chan_map: scriptOp[chan_map['animmode']][0] = 1.0
        return

    if mode == 'SKELETON':
        # Read per-bone rotations straight off your TD bone rig and route them
        # through the normal post-chain (smoothing + global order + write).
        _skel_bypass_offset = bool(scriptOp.par.Skelraw.eval()) if hasattr(scriptOp.par, 'Skelraw') else True
        # SKELETON is single-skeleton. If Multiperson is ON the channels are
        # p1_/p2_.. prefixed, so writing unprefixed would silently miss every
        # channel. Bind to the p1_ slot in that case so output still lands.
        _active_person_prefix = 'p1_' if _multi_now else ''
        _bind_person_state('_single')
        chan_map = scriptOp.storage.get('chan_map', {})
        if 'animmode' in chan_map: scriptOp[chan_map['animmode']][0] = 2.0
        rev_map = _REVERSE_MAPS.get(current_rig, {})
        skel = read_skeleton_rotations(scriptOp, rev_map)
        if not skel:
            _seen = scriptOp.storage.get('skel_seen', [])
            if not _seen:
                log('SKELETON: Skelroot found no child COMPs - is Skelroot set to '
                    'the geo/parent that CONTAINS the bones?', 'WARN', scriptOp)
            else:
                log(f'SKELETON: {len(_seen)} COMPs under Skelroot but none matched a '
                    f'rig bone. Saw e.g. {_seen[:6]} - add aliases for these.',
                    'WARN', scriptOp)
            return
        _nmatch = len(skel)
        if scriptOp.storage.get('skel_last_n') != _nmatch:
            scriptOp.storage['skel_last_n'] = _nmatch
            log(f'SKELETON: {_nmatch} bones matched, writing to '
                f'"{_active_person_prefix or "(no prefix)"}" channels', 'INFO', scriptOp)
        for generic_bone, q_local in skel.items():
            rx, ry, rz = quat_to_euler(q_local)   # carrier; set_rotation re-quats
            set_rotation(scriptOp, generic_bone, rx, ry, rz, scriptOp.par.Rotationsmooth)
        tpos = _skel_root_translation(scriptOp)
        if tpos is not None:
            set_translation(scriptOp, 'Hips', tpos[0], tpos[1], tpos[2])
        if LOG_HEARTBEAT and _log_cook % LOG_HEARTBEAT == 0:
            log(f'ok | SKELETON bones={len(skel)} frame={scriptOp.par.Skelframe.eval()} '
                f'raw={_skel_bypass_offset}', 'DEBUG', scriptOp)
        return

    # ── MOCAP (multi-person capable) ──────────────────────────────────────
    if len(scriptOp.inputs) == 0 or scriptOp.inputs[0] is None:
        log('no mocap input on input 0', 'WARN', scriptOp)
        return
    mocap_in = scriptOp.inputs[0]
    chan_map = scriptOp.storage.get('chan_map', {})
    if 'animmode' in chan_map:
        scriptOp[chan_map['animmode']][0] = 0.0

    multi = bool(scriptOp.par.Multiperson.eval()) if hasattr(scriptOp.par, 'Multiperson') else False
    maxp  = max(1, min(5, int(scriptOp.par.Maxpeople.eval()))) if hasattr(scriptOp.par, 'Maxpeople') else 1
    hand_tracking_on = bool(scriptOp.par.Handtracking.eval()) if hasattr(scriptOp.par, 'Handtracking') else False
    flips = get_coord_flips(scriptOp)

    people = group_people_landmarks(scriptOp, mocap_in, flips, multi, maxp)
    if not people:
        log('mocap input has no bone:axis channels', 'WARN', scriptOp)
        return

    # Single-person visibility CHOP path unchanged; multi uses inline :v per person.
    if not multi:
        _vch = _visibility_chop(scriptOp)
        if _vch is not None:
            _c = parse_confidence_from_chop(_vch)
            if _c and not any(k in _c for k in
                              ('left_shoulder', 'right_shoulder', 'left_hip', 'right_hip')):
                log('Visibility CHOP wired but no joint names matched - check its '
                    'channel names (want e.g. left_elbow / left_elbow:visibility)',
                    'WARN', scriptOp)
            if _c:
                people[0] = (people[0][0], people[0][1], _c)

    # Hand CHOPs apply to the primary (first) person only.
    l_chop = _hand_chop(scriptOp, 'Lhandchop', 1)
    r_chop = _hand_chop(scriptOp, 'Rhandchop', 2)
    if hasattr(scriptOp.par, 'Swaphands') and scriptOp.par.Swaphands.eval():
        l_chop, r_chop = r_chop, l_chop
    prim_l_hand = parse_hand_input_chop(l_chop, flips)
    prim_r_hand = parse_hand_input_chop(r_chop, flips)

    solved = set()
    for _i, (tag, _lm, _cf) in enumerate(people):
        _active_person_prefix = f'{tag}_' if multi else ''
        _bind_person_state(tag if multi else '_single')
        _primary = (_i == 0)
        _ok = _solve_body(scriptOp, _lm, _cf,
                          prim_l_hand if _primary else {},
                          prim_r_hand if _primary else {},
                          hand_tracking_on,
                          use_root_chop=(_primary and not multi))
        _capture_person_scalars(tag if multi else '_single')
        if multi:
            _set_present(scriptOp, tag, 1.0 if _ok else 0.0)
            if _ok:
                solved.add(tag)
    if multi:
        for _i in range(1, maxp + 1):
            _t = f'p{_i}'
            if _t not in solved:
                _set_present(scriptOp, _t, 0.0)
    _active_person_prefix = ''

    if LOG_HEARTBEAT and _log_cook % LOG_HEARTBEAT == 0:
        log(f'ok | people={len(people)} multi={multi} maxp={maxp}', 'DEBUG', scriptOp)


def _solve_body(scriptOp, landmarks, conf, l_hand_lms, r_hand_lms,
                hand_tracking_on, use_root_chop):
    """One person's full MOCAP solve. Writes to the ACTIVE person's channels via
    _active_person_prefix; per-person temporal state must be bound first (see
    _bind_person_state). Returns False if the frame was skipped for missing core
    landmarks. Body of sections 1-9 is the original single-person solve, unchanged
    except: torso-confidence variable renamed _tconf -> tconf, and the root CHOP
    is gated by use_root_chop (primary person only)."""
    global _conf_smooth_floor
    _limb_debug.clear()
    _bone_out_q.clear()

    tconf = torso_confidence(conf)

    # ── Confidence-driven smoothing ───────────────────────────────────────
    _bone_conf.clear()
    if hasattr(scriptOp.par, 'Confsmooth') and scriptOp.par.Confsmooth.eval():
        _conf_smooth_floor = scriptOp.par.Confsmoothfloor.eval() if hasattr(scriptOp.par, 'Confsmoothfloor') else 0.15
        for _bone, _drivers in CONF_DRIVERS.items():
            _vals = [conf[d] for d in _drivers if d in conf]
            if _vals:
                _bone_conf[_bone] = min(_vals)

    landmarks = facing_correct(scriptOp, landmarks, conf)     # back-facing (pre-repair)
    landmarks = repair_landmarks(scriptOp, landmarks, conf)
    landmarks = predict_landmarks(scriptOp, landmarks)
    landmarks = fit_bone_lengths(scriptOp, landmarks, conf)
    landmarks = anti_clip_arms(scriptOp, landmarks)

    # ── Limb-joint XYZ passthrough (solve-space -> matching bone tx/ty/tz) ──
    if hasattr(scriptOp.par, 'Limbxyz') and scriptOp.par.Limbxyz.eval():
        _cm = scriptOp.storage.get('chan_map', {})
        _rig = scriptOp.par.Rigtype.eval() if hasattr(scriptOp.par, 'Rigtype') else 'Mixamo'
        _bmap = RIG_MAPPINGS.get(_rig, RIG_MAPPINGS['Mixamo'])
        for _gb in LIMB_XYZ_BONES:
            _pt = landmarks.get(LIMB_XYZ_MAP[_gb])
            if not _pt or not _finite(*_pt):
                continue
            _rb = _bmap.get(_gb, _gb)
            for _ax, _v in zip(('tx','ty','tz'), _pt):
                _c = f'{_active_person_prefix}{_rb}:{_ax}'
                if _c in _cm:
                    scriptOp[_cm[_c]][0] = _v

    l_hip = landmarks.get('left_hip');   r_hip = landmarks.get('right_hip')
    l_sho = landmarks.get('left_shoulder'); r_sho = landmarks.get('right_shoulder')
    if not l_hip or not r_hip or not l_sho or not r_sho:
        log('missing hip/shoulder landmarks - skipping frame', 'WARN', scriptOp)
        return False

    hip_center   = vec_scale(vec_add(l_hip, r_hip), 0.5)
    chest_center = vec_scale(vec_add(l_sho, r_sho), 0.5)
    spine_vec    = vec_sub(chest_center, hip_center)
    hip_right    = vec_sub(r_hip, l_hip)
    sho_right    = vec_sub(r_sho, l_sho)
    # ── v2.9.13: reject 1-frame 180° flips of the torso right-vectors (the
    # near/far shoulder/hip depth-order swap at profile that faces the chest
    # backwards). A sustained reversal (a real turn) is released after N frames.
    if hasattr(scriptOp.par, 'Facinglock') and scriptOp.par.Facinglock.eval():
        _flk = int(scriptOp.par.Facinglockframes.eval()) if hasattr(scriptOp.par, 'Facinglockframes') else 4
        hip_right = facing_lock('hip', hip_right, _flk)
        sho_right = facing_lock('sho', sho_right, _flk)

    # ── Hips translation ──────────────────────────────────────────────────
    root_scale  = scriptOp.par.Rootscale.eval() if hasattr(scriptOp.par, 'Rootscale') else 100.0
    root_smooth = scriptOp.par.Rootsmooth.eval() if hasattr(scriptOp.par, 'Rootsmooth') else 0.5
    root_chop   = None
    if use_root_chop and hasattr(scriptOp.par, 'Rootchop'):
        rcp = scriptOp.par.Rootchop.eval()
        if rcp:
            root_chop = op(rcp)

    if root_chop:
        ss_lms = {}
        for ch in root_chop.chans():
            if ':' not in ch.name: continue
            bname, ax = ch.name.split(':', 1)
            bname = bname.lower().strip(); ax = ax.lower().strip()
            if ax not in ('x', 'y', 'z'): continue
            ss_lms.setdefault(bname, [0.0, 0.0, 0.0])
            if   ax == 'x': ss_lms[bname][0] = ch[0]
            elif ax == 'y': ss_lms[bname][1] = ch[0]
            elif ax == 'z': ss_lms[bname][2] = ch[0]

        ss_lhip = ss_lms.get('left_hip')
        ss_rhip = ss_lms.get('right_hip')

        if ss_lhip and ss_rhip:
            sx = (ss_lhip[0] + ss_rhip[0]) * 0.5 - 0.5
            sy = -((ss_lhip[1] + ss_rhip[1]) * 0.5 - 0.5)

            mirror_x = bool(scriptOp.par.Rootmirrorx.eval()) if hasattr(scriptOp.par, 'Rootmirrorx') else True
            if mirror_x:
                sx = -sx

            depth_scale = scriptOp.par.Rootdepthscale.eval() if hasattr(scriptOp.par, 'Rootdepthscale') else 100.0
            sz = hip_center[2] * depth_scale

            raw_pos = [sx * root_scale, sy * root_scale, sz]
            pos = smooth_position(raw_pos, root_smooth)
            pos = _finalize_root(scriptOp, landmarks, pos)          # v2.9.11
            pos = apply_root_life(scriptOp, landmarks, pos)         # v2.9.12
            set_translation(scriptOp, 'Hips', pos[0], pos[1], pos[2])
        else:
            raw_pos = [hip_center[0] * root_scale, hip_center[1] * root_scale, hip_center[2] * root_scale]
            pos = smooth_position(raw_pos, root_smooth)
            pos = _finalize_root(scriptOp, landmarks, pos)          # v2.9.11
            pos = apply_root_life(scriptOp, landmarks, pos)         # v2.9.12
            set_translation(scriptOp, 'Hips', pos[0], pos[1], pos[2])
    else:
        raw_pos = [hip_center[0] * root_scale, hip_center[1] * root_scale, hip_center[2] * root_scale]
        pos = smooth_position(raw_pos, root_smooth)
        pos = _finalize_root(scriptOp, landmarks, pos)              # v2.9.11
        pos = apply_root_life(scriptOp, landmarks, pos)             # v2.9.12
        set_translation(scriptOp, 'Hips', pos[0], pos[1], pos[2])

    # ── 1. Hips rotation ──────────────────────────────────────────────────
    hip_right_n = vec_norm(hip_right)
    world_up    = [0, 1, 0]
    hip_up_raw  = vec_sub(world_up, vec_scale(hip_right_n, vec_dot(world_up, hip_right_n)))
    hip_up      = vec_norm(hip_up_raw)
    if vec_len(hip_up) < 1e-6:
        hip_up = [0, 1, 0]
    q_hips_world = quat_from_frame_vecs(hip_up, hip_right, [0,1,0], [1,0,0])
    if hasattr(scriptOp.par,'Turngate') and scriptOp.par.Turngate.eval():   # v2.9.11/12
        q_hips_world = adaptive_gate(scriptOp, 'hips', q_hips_world, tconf)
    h_rx,h_ry,h_rz = quat_to_euler(q_hips_world)
    set_rotation(scriptOp, 'Hips', h_rx, h_ry, h_rz, scriptOp.par.Rotationsmooth)

    # ── 2. Spine ──────────────────────────────────────────────────────────
    q_chest_world  = quat_from_frame_vecs(spine_vec, sho_right, [0,1,0], [1,0,0])
    if hasattr(scriptOp.par,'Turngate') and scriptOp.par.Turngate.eval():   # v2.9.11/12
        q_chest_world = adaptive_gate(scriptOp, 'chest', q_chest_world, tconf)
    q_torso_rel    = quat_mult(quat_inv(q_hips_world), q_chest_world)
    q_spine_local  = quat_slerp([1,0,0,0], q_torso_rel, 1.0/3.0)
    q_spine2_accum = quat_slerp([1,0,0,0], q_torso_rel, 2.0/3.0)
    q_spine1_local = quat_mult(quat_inv(q_spine_local), q_spine2_accum)
    q_spine2_local = quat_mult(quat_inv(q_spine2_accum), q_torso_rel)
    s_rx, s_ry, s_rz   = quat_to_euler(q_spine_local)
    s1_rx,s1_ry,s1_rz  = quat_to_euler(q_spine1_local)
    s2_rx,s2_ry,s2_rz  = quat_to_euler(q_spine2_local)
    set_rotation(scriptOp,'Spine', s_rx, s_ry, s_rz, scriptOp.par.Rotationsmooth)
    set_rotation(scriptOp,'Spine1',s1_rx,s1_ry,s1_rz,scriptOp.par.Rotationsmooth)
    set_rotation(scriptOp,'Spine2',s2_rx,s2_ry,s2_rz,scriptOp.par.Rotationsmooth)
    q_chest_accum = quat_mult(q_hips_world, q_torso_rel)

    # ── 3. Neck & Head ────────────────────────────────────────────────────
    nose  = landmarks.get('nose')
    l_ear = landmarks.get('left_ear')
    r_ear = landmarks.get('right_ear')
    if nose and l_ear and r_ear:
        ear_center  = vec_scale(vec_add(l_ear,r_ear),0.5)
        head_up_raw = vec_sub(nose, ear_center)
        ear_right   = vec_sub(r_ear, l_ear)
        q_head_world = quat_from_frame_vecs(head_up_raw, ear_right, [0,1,0], [1,0,0])
        q_neck_full  = quat_mult(quat_inv(q_chest_accum), q_head_world)
        q_neck_local = quat_slerp([1,0,0,0], q_neck_full, 0.4)
        n_rx,n_ry,n_rz = quat_to_euler(q_neck_local)
        set_rotation(scriptOp,'Neck',n_rx,n_ry,n_rz,scriptOp.par.Rotationsmooth)
        q_neck_world = quat_mult(q_chest_accum, q_neck_local)
        q_head_local = quat_mult(quat_inv(q_neck_world), q_head_world)
        hd_rx,hd_ry,hd_rz = quat_to_euler(q_head_local)
        set_rotation(scriptOp,'Head',hd_rx,hd_ry,hd_rz,scriptOp.par.Rotationsmooth)

    # ── 4. Shoulders ──────────────────────────────────────────────────────
    l_sho_dir = vec_sub(l_sho, chest_center)
    q_lsh_world = quat_from_frame_vecs(l_sho_dir,[0,-1,0],[-1,0,0],[0,-1,0])
    q_lsh_local_full = quat_mult(quat_inv(q_chest_accum), q_lsh_world)
    q_lsh_local_out  = quat_slerp([1,0,0,0], q_lsh_local_full, 0.5)
    lsh_rx,lsh_ry,lsh_rz = quat_to_euler(q_lsh_local_out)
    set_rotation(scriptOp,'LeftShoulder',lsh_rx,lsh_ry,lsh_rz,scriptOp.par.Armsmooth)
    # v2.9.14: shoulder PLACEMENT (Y/Z) is applied in section 5b via
    # place_offset_pair, which cancels it exactly on the arm. Nothing to do here.

    r_sho_dir = vec_sub(r_sho, chest_center)
    q_rsh_world = quat_from_frame_vecs(r_sho_dir,[0,-1,0],[1,0,0],[0,-1,0])
    q_rsh_local_full = quat_mult(quat_inv(q_chest_accum), q_rsh_world)
    q_rsh_local_out  = quat_slerp([1,0,0,0], q_rsh_local_full, 0.5)
    rsh_rx,rsh_ry,rsh_rz = quat_to_euler(q_rsh_local_out)
    set_rotation(scriptOp,'RightShoulder',rsh_rx,rsh_ry,rsh_rz,scriptOp.par.Armsmooth)

    # ── 5. Upper arms ─────────────────────────────────────────────────────
    q_larm_world = None
    if 'left_elbow' in landmarks:
        arm_dir_world = vec_sub(landmarks['left_elbow'], l_sho)
        # Arm hangs off the CHEST, not the shoulder — the shoulder's solved
        # rotation isn't baked into the arm's WORLD frame here, so the solve is
        # stable. The FBX still parents the arm under the shoulder, so a shoulder
        # placement offset would move the arm — section 5b cancels that exactly.
        arm_local     = _quat_rotate_vec(quat_inv(q_chest_accum), arm_dir_world)
        q_larm_local  = quat_from_two_vecs([-1,0,0], arm_local)
        q_larm_world  = quat_mult(q_chest_accum, q_larm_local)
        larm_rx,larm_ry,larm_rz = quat_to_euler(q_larm_local)
        set_rotation(scriptOp,'LeftArm',larm_rx,larm_ry,larm_rz,scriptOp.par.Armsmooth)

    q_rarm_world = None
    if 'right_elbow' in landmarks:
        arm_dir_world = vec_sub(landmarks['right_elbow'], r_sho)
        # Right arm also hangs off the CHEST now (see left arm note).
        arm_local     = _quat_rotate_vec(quat_inv(q_chest_accum), arm_dir_world)
        q_rarm_local  = quat_from_two_vecs([1,0,0], arm_local)
        q_rarm_world  = quat_mult(q_chest_accum, q_rarm_local)
        rarm_rx,rarm_ry,rarm_rz = quat_to_euler(q_rarm_local)
        set_rotation(scriptOp,'RightArm',rarm_rx,rarm_ry,rarm_rz,scriptOp.par.Armsmooth)

    # ── 5b. Shoulder PLACEMENT offsets (exact arm cancel) ─────────────────
    # Rotate each shoulder by (offX, offY, offZ) in its own local frame to fix
    # the bind mesh, and pre-multiply the arm by the inverse so the arm/forearm/
    # hand chain does NOT move. Runs AFTER both shoulder (§4) and arm (§5) are
    # solved & stashed. The forearm (§6) reads the arm's WORLD quat variable
    # (unchanged), so it rides along correctly. Offsets 0 → no-op.
    _loffx = scriptOp.par.Lshoffx.eval() if hasattr(scriptOp.par,'Lshoffx') else 0.0
    _loffy = scriptOp.par.Lshoffy.eval() if hasattr(scriptOp.par,'Lshoffy') else 0.0
    _loffz = scriptOp.par.Lshoffz.eval() if hasattr(scriptOp.par,'Lshoffz') else 0.0
    _roffx = scriptOp.par.Rshoffx.eval() if hasattr(scriptOp.par,'Rshoffx') else 0.0
    _roffy = scriptOp.par.Rshoffy.eval() if hasattr(scriptOp.par,'Rshoffy') else 0.0
    _roffz = scriptOp.par.Rshoffz.eval() if hasattr(scriptOp.par,'Rshoffz') else 0.0
    place_offset_pair(scriptOp, 'LeftShoulder',  'LeftArm',  (_loffx, _loffy, _loffz))
    place_offset_pair(scriptOp, 'RightShoulder', 'RightArm', (_roffx, _roffy, _roffz))

    # ── 6. Forearms ───────────────────────────────────────────────────────
    q_lfa_world = None
    if q_larm_world and 'left_wrist' in landmarks and 'left_elbow' in landmarks:
        fa_dir_world = vec_sub(landmarks['left_wrist'], landmarks['left_elbow'])
        fa_local     = _quat_rotate_vec(quat_inv(q_larm_world), fa_dir_world)
        q_lfa_local  = quat_from_two_vecs([-1,0,0], fa_local)
        q_lfa_world  = quat_mult(q_larm_world, q_lfa_local)
        lfa_rx,lfa_ry,lfa_rz = quat_to_euler(q_lfa_local)
        set_rotation(scriptOp,'LeftForeArm',lfa_rx,lfa_ry,lfa_rz,scriptOp.par.Armsmooth)

    q_rfa_world = None
    if q_rarm_world and 'right_wrist' in landmarks and 'right_elbow' in landmarks:
        fa_dir_world = vec_sub(landmarks['right_wrist'], landmarks['right_elbow'])
        fa_local     = _quat_rotate_vec(quat_inv(q_rarm_world), fa_dir_world)
        q_rfa_local  = quat_from_two_vecs([1,0,0], fa_local)
        q_rfa_world  = quat_mult(q_rarm_world, q_rfa_local)
        rfa_rx,rfa_ry,rfa_rz = quat_to_euler(q_rfa_local)
        set_rotation(scriptOp,'RightForeArm',rfa_rx,rfa_ry,rfa_rz,scriptOp.par.Armsmooth)

    # ── 7. Hands  (gated by Handtracking toggle) ─────────────────────────
    q_lhand_world = None
    q_rhand_world = None

    if hand_tracking_on:
        has_l_hand_input = bool(l_hand_lms)
        has_r_hand_input = bool(r_hand_lms)

        if has_l_hand_input and q_lfa_world and l_hand_lms.get(0) and l_hand_lms.get(9):
            hand_dir   = vec_sub(l_hand_lms[9], l_hand_lms[0])
            hand_right = vec_sub(l_hand_lms.get(17, l_hand_lms[0]),
                                 l_hand_lms.get(5,  l_hand_lms[0]))
            q_lhand_world = quat_from_frame_vecs(hand_dir, hand_right,
                                                  [-1,0,0], [0,0,1])
            q_lhand_local = quat_mult(quat_inv(q_lfa_world), q_lhand_world)
            lh_rx, lh_ry, lh_rz = quat_to_euler(q_lhand_local)
            set_rotation(scriptOp, 'LeftHand', lh_rx, lh_ry, lh_rz,
                         scriptOp.par.Handsmooth)
        else:
            q_lhand_world = _solve_pose_hand(scriptOp, landmarks, 'Left',
                                              q_lfa_world)

        if has_r_hand_input and q_rfa_world and r_hand_lms.get(0) and r_hand_lms.get(9):
            hand_dir   = vec_sub(r_hand_lms[9], r_hand_lms[0])
            hand_right = vec_sub(r_hand_lms.get(5,  r_hand_lms[0]),
                                 r_hand_lms.get(17, r_hand_lms[0]))
            q_rhand_world = quat_from_frame_vecs(hand_dir, hand_right,
                                                  [1,0,0], [0,0,1])
            q_rhand_local = quat_mult(quat_inv(q_rfa_world), q_rhand_world)
            rh_rx, rh_ry, rh_rz = quat_to_euler(q_rhand_local)
            set_rotation(scriptOp, 'RightHand', rh_rx, rh_ry, rh_rz,
                         scriptOp.par.Handsmooth)
        else:
            q_rhand_world = _solve_pose_hand(scriptOp, landmarks, 'Right',
                                              q_rfa_world)

        # ── 8. Fingers (only when dedicated hand CHOPs are wired) ────────
        def solve_fingers(hand_lms, side, q_hand_world_parent):
            if not hand_lms: return
            # v2.9.11: CURL mode = angle-based hinge solve (parent-relative,
            # doesn't need the world parent frame). FRAME mode = original.
            if (scriptOp.par.Fingermode.eval() if hasattr(scriptOp.par,'Fingermode') else 'FRAME') == 'CURL':
                _solve_fingers_curl(scriptOp, hand_lms, side)
                return
            if q_hand_world_parent is None: return
            wrist = hand_lms.get(0); idx_mcp = hand_lms.get(5)
            pnk_mcp = hand_lms.get(17)
            if not wrist or not idx_mcp or not pnk_mcp: return
            palm_fwd_raw   = vec_sub(idx_mcp, wrist)
            palm_right_raw = (vec_sub(idx_mcp, pnk_mcp) if side == 'Left'
                              else vec_sub(pnk_mcp, idx_mcp))
            palm_normal    = vec_norm(vec_cross(palm_fwd_raw, palm_right_raw))
            rest_primary   = [-1,0,0] if side == 'Left' else [1,0,0]
            for finger, idxs in FINGER_MP_INDICES.items():
                bp = f'{side}Hand{finger}'
                mcp_pos = hand_lms.get(idxs['mcp'])
                pip_pos = hand_lms.get(idxs['pip'])
                dip_pos = hand_lms.get(idxs['dip'])
                tip_pos = hand_lms.get(idxs['tip'])
                if not mcp_pos: continue
                p1_dir = (vec_sub(pip_pos, mcp_pos) if pip_pos
                          else vec_sub(mcp_pos, wrist))
                q_p1_world = quat_from_frame_vecs(p1_dir, palm_normal,
                                                   rest_primary, [0,0,1])
                q_p1_local = quat_mult(quat_inv(q_hand_world_parent),
                                       q_p1_world)
                p1_rx, p1_ry, p1_rz = quat_to_euler(q_p1_local)
                set_rotation(scriptOp, f'{bp}1', p1_rx, p1_ry, p1_rz,
                             scriptOp.par.Handsmooth)
                if pip_pos and dip_pos:
                    p2_dir = vec_sub(dip_pos, pip_pos)
                    q_p2_world = quat_from_frame_vecs(p2_dir, palm_normal,
                                                       rest_primary, [0,0,1])
                    q_p2_local = quat_mult(quat_inv(q_p1_world), q_p2_world)
                    p2_rx, p2_ry, p2_rz = quat_to_euler(q_p2_local)
                    set_rotation(scriptOp, f'{bp}2', p2_rx, p2_ry, p2_rz,
                                 scriptOp.par.Handsmooth)
                    if tip_pos:
                        p3_dir = vec_sub(tip_pos, dip_pos)
                        q_p3_world = quat_from_frame_vecs(p3_dir, palm_normal,
                                                           rest_primary, [0,0,1])
                        q_p3_local = quat_mult(quat_inv(q_p2_world), q_p3_world)
                        p3_rx, p3_ry, p3_rz = quat_to_euler(q_p3_local)
                        set_rotation(scriptOp, f'{bp}3', p3_rx, p3_ry, p3_rz,
                                     scriptOp.par.Handsmooth)

        solve_fingers(l_hand_lms, 'Left',
                      q_lhand_world if q_lhand_world else q_lfa_world)
        solve_fingers(r_hand_lms, 'Right',
                      q_rhand_world if q_rhand_world else q_rfa_world)

    # ── 9. Legs & Feet ────────────────────────────────────────────────────
    if hasattr(scriptOp.par, 'Legik') and scriptOp.par.Legik.eval():
        # v2.9.12: additive two-bone IK + ground contact (replaces the FK leg/
        # foot writes below only when the toggle is ON; weight 0 == exact FK).
        apply_leg_ground_ik(scriptOp, landmarks)
    else:
        q_lleg_world = None
        if 'left_knee' in landmarks:
            leg_dir = vec_sub(landmarks['left_knee'], l_hip)
            q_lul = quat_from_two_vecs([0,-1,0], leg_dir)
            rx,ry,rz = quat_to_euler(q_lul)
            set_rotation(scriptOp, 'LeftUpLeg', rx, ry, rz, scriptOp.par.Rotationsmooth)

            if 'left_ankle' in landmarks:
                calf_dir = vec_sub(landmarks['left_ankle'], landmarks['left_knee'])
                calf_local = _quat_rotate_vec(quat_inv(q_lul), calf_dir)
                q_lcalf_local = quat_from_two_vecs([0,-1,0], calf_local)
                q_lleg_world  = quat_mult(q_lul, q_lcalf_local)
                rx,ry,rz = quat_to_euler(q_lcalf_local)
                set_rotation(scriptOp, 'LeftLeg', rx, ry, rz, scriptOp.par.Rotationsmooth)

        if q_lleg_world and 'left_heel' in landmarks and 'left_foot_index' in landmarks:
            foot_fwd  = vec_sub(landmarks['left_foot_index'], landmarks['left_heel'])
            foot_up   = vec_sub(landmarks['left_ankle'], landmarks['left_heel'])
            q_lfoot_world = quat_from_frame_vecs(foot_fwd, foot_up, [0,0,-1], [0,1,0])
            q_lfoot_local = quat_mult(quat_inv(q_lleg_world), q_lfoot_world)
            rx,ry,rz = quat_to_euler(q_lfoot_local)
            set_rotation(scriptOp, 'LeftFoot', rx, ry, rz, scriptOp.par.Rotationsmooth)

            toe_dir = vec_sub(landmarks['left_foot_index'], landmarks['left_ankle'])
            q_ltoe_world = quat_from_frame_vecs(toe_dir, foot_up, [0,0,-1], [0,1,0])
            q_ltoe_local = quat_mult(quat_inv(q_lfoot_world), q_ltoe_world)
            rx,ry,rz = quat_to_euler(q_ltoe_local)
            set_rotation(scriptOp, 'LeftToe', rx, ry, rz, scriptOp.par.Rotationsmooth)

        q_rleg_world = None
        if 'right_knee' in landmarks:
            leg_dir = vec_sub(landmarks['right_knee'], r_hip)
            q_rul = quat_from_two_vecs([0,-1,0], leg_dir)
            rx,ry,rz = quat_to_euler(q_rul)
            set_rotation(scriptOp, 'RightUpLeg', rx, ry, rz, scriptOp.par.Rotationsmooth)

            if 'right_ankle' in landmarks:
                calf_dir = vec_sub(landmarks['right_ankle'], landmarks['right_knee'])
                calf_local = _quat_rotate_vec(quat_inv(q_rul), calf_dir)
                q_rcalf_local = quat_from_two_vecs([0,-1,0], calf_local)
                q_rleg_world  = quat_mult(q_rul, q_rcalf_local)
                rx,ry,rz = quat_to_euler(q_rcalf_local)
                set_rotation(scriptOp, 'RightLeg', rx, ry, rz, scriptOp.par.Rotationsmooth)

        if q_rleg_world and 'right_heel' in landmarks and 'right_foot_index' in landmarks:
            foot_fwd  = vec_sub(landmarks['right_foot_index'], landmarks['right_heel'])
            foot_up   = vec_sub(landmarks['right_ankle'], landmarks['right_heel'])
            q_rfoot_world = quat_from_frame_vecs(foot_fwd, foot_up, [0,0,-1], [0,1,0])
            q_rfoot_local = quat_mult(quat_inv(q_rleg_world), q_rfoot_world)
            rx,ry,rz = quat_to_euler(q_rfoot_local)
            set_rotation(scriptOp, 'RightFoot', rx, ry, rz, scriptOp.par.Rotationsmooth)

            toe_dir = vec_sub(landmarks['right_foot_index'], landmarks['right_ankle'])
            q_rtoe_world = quat_from_frame_vecs(toe_dir, foot_up, [0,0,-1], [0,1,0])
            q_rtoe_local = quat_mult(quat_inv(q_rfoot_world), q_rtoe_world)
            rx,ry,rz = quat_to_euler(q_rtoe_local)
            set_rotation(scriptOp, 'RightToe', rx, ry, rz, scriptOp.par.Rotationsmooth)

    # ── Debug limb angles → LIMBS DAT ─────────────────────────────────────
    if hasattr(scriptOp.par, 'Debuglimbs') and scriptOp.par.Debuglimbs.eval():
        write_limb_debug(scriptOp)

    return True
