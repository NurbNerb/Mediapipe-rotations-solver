LOG_DAT_NAME   = 'LOG'
LOG_MAX_LINES  = 200
LOG_LEVELS     = {'DEBUG': 0, 'INFO': 1, 'WARN': 2, 'ERROR': 3}
LOG_MIN_LEVEL  = 'INFO'          # 'DEBUG' = everything, 'WARN' = quiet
LOG_HEARTBEAT  = 30              # emit a status line every N cooks (0 = off)
_log_last      = {'key': None, 'n': 0}
_log_cook      = 0

def _log_dat(scriptOp=None):
    d = op(LOG_DAT_NAME)
    if d is None and scriptOp is not None:
        try:
            d = scriptOp.parent().create(tableDAT, LOG_DAT_NAME)
            d.nodeX, d.nodeY = scriptOp.nodeX + 200, scriptOp.nodeY - 150
        except Exception:
            d = None
    return d

def log(msg, level='INFO', scriptOp=None):
    if LOG_LEVELS.get(level, 1) < LOG_LEVELS.get(LOG_MIN_LEVEL, 1):
        return
    d = _log_dat(scriptOp)
    if d is None:
        return
    if d.numRows == 0:
        d.appendRow(['frame', 't', 'level', 'message'])
    key = (level, msg)
    # collapse consecutive duplicates into a single row with a counter
    if _log_last['key'] == key and d.numRows > 1:
        _log_last['n'] += 1
        try:
            d[d.numRows - 1, 'message'] = f'{msg}  (x{_log_last["n"] + 1})'
            return
        except Exception:
            pass
    else:
        _log_last['key'] = key
        _log_last['n']   = 0
    try:    fr = int(absTime.frame)
    except Exception: fr = 0
    try:    t = f'{absTime.seconds:.2f}'
    except Exception: t = '0'
    d.appendRow([fr, t, level, msg])
    while d.numRows > LOG_MAX_LINES + 1:
        d.deleteRow(1)

def log_clear():
    d = op(LOG_DAT_NAME)
    if d is not None:
        d.clear()

