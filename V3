def _mat_to_quat_normcols(m):
    """tdu.Matrix (4x4) -> rotation quat. Columns are the local axes; normalise
    them to strip scale, then mat3->quat. Convention-free: no euler order."""
    # tdu.Matrix indexes as m[row, col]; take the 3x3 rotation block.
    cx = vec_norm([m[0,0], m[1,0], m[2,0]])
    cy = vec_norm([m[0,1], m[1,1], m[2,1]])
    cz = vec_norm([m[0,2], m[1,2], m[2,2]])
    return quat_norm(mat3_to_quat([[cx[0],cy[0],cz[0]],
                                   [cx[1],cy[1],cz[1]],
                                   [cx[2],cy[2],cz[2]]]))

def _skel_alias_table(scriptOp):
    """Optional DAT: rows [comp_name, generic_bone] for non-standard bone names.
    Header row [name/bone, generic] auto-skipped. Returns {norm_name: generic}."""
    out = {}
    pth = scriptOp.par.Skelaliastable.eval() if hasattr(scriptOp.par, 'Skelaliastable') else ''
    if not pth:
        return out
    d = op(pth)
    if d is None or d.numRows == 0:
        return out
    try:
        start = 1 if str(d[0,0].val).strip().lower() in ('name','bone','comp') else 0
    except Exception:
        start = 0
    for r in range(start, d.numRows):
        try:
            out[_norm_key(d[r,0].val)] = str(d[r,1].val).strip()
        except Exception:
            pass
    return out

def read_skeleton_rotations(scriptOp, rev_map):
    """Read your TD skeleton's bone COMPs and return {generic_bone: local_quat}
    in the rig frame. Rotation is read as a MATRIX (no euler order to guess).
    Frame Local -> localTransform (parent-relative, use directly). Frame World ->
    worldTransform, unwound to rig-local via GENERIC_PARENT (robust when your
    parenting differs from the rig hierarchy). Bone names match alnum-normalised
    against generic + rig names + the alias DAT."""
    out = {}
    root = op(scriptOp.par.Skelroot.eval()) if (hasattr(scriptOp.par,'Skelroot') and scriptOp.par.Skelroot.eval()) else None
    if root is None:
        return out
    frame = scriptOp.par.Skelframe.eval() if hasattr(scriptOp.par, 'Skelframe') else 'Local'
    pat   = (scriptOp.par.Skelnamepat.eval() or '*') if hasattr(scriptOp.par, 'Skelnamepat') else '*'

    name_to_generic = {_norm_key(g): g for g in GENERIC_BONES}
    for rig_name, g in rev_map.items():
        name_to_generic[_norm_key(rig_name)] = g
    name_to_generic.update(_skel_alias_table(scriptOp))

    comps = {}
    _seen = []                                   # every COMP name we walked, for diag
    # depth=None -> recurse the whole hierarchy (bones are nested under each other,
    # not direct children of Skelroot), so we don't miss anything below depth 1.
    for ch in root.findChildren(type=COMP, depth=None):
        _seen.append(ch.name)
        g = name_to_generic.get(_norm_key(ch.name))
        if g is not None:
            comps[g] = ch
    scriptOp.storage['skel_seen']    = _seen
    scriptOp.storage['skel_matched'] = sorted(comps.keys())

    if frame == 'World':
        world = {}
        for g, comp in comps.items():
            try:
                world[g] = _mat_to_quat_normcols(comp.worldTransform)
            except Exception:
                pass
        for g, wq in world.items():
            par = GENERIC_PARENT.get(g)
            pw = world.get(par) if par else None
            q = quat_mult(quat_inv(pw), wq) if pw else wq
            if _finite(*q):
                out[g] = quat_norm(q)
    else:
        for g, comp in comps.items():
            try:
                q = _mat_to_quat_normcols(comp.localTransform)
                if _finite(*q):
                    out[g] = q
            except Exception:
                pass
    return out

def _skel_root_translation(scriptOp):
    """Optional Hips translation from a designated skeleton COMP (Skelhips).
    Returns [tx,ty,tz]*scale, or None to leave translation untouched."""
    pth = scriptOp.par.Skelhips.eval() if hasattr(scriptOp.par, 'Skelhips') else ''
    if not pth:
        return None
    comp = op(pth)
    if comp is None:
        return None
    sc = scriptOp.par.Skelrootscale.eval() if hasattr(scriptOp.par, 'Skelrootscale') else 1.0
    try:
        m = comp.worldTransform
        return [m[0,3]*sc, m[1,3]*sc, m[2,3]*sc]
    except Exception:
        return None

