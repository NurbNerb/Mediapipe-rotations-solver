def _solve_pose_hand(scriptOp, landmarks, side, q_forearm_world):
    if q_forearm_world is None:
        return None

    prefix = side.lower()
    wrist = landmarks.get(f'{prefix}_wrist')
    idx   = landmarks.get(f'{prefix}_index')
    pnk   = landmarks.get(f'{prefix}_pinky')

    if not wrist or not idx or not pnk:
        return None

    mid_knuckle = vec_scale(vec_add(idx, pnk), 0.5)
    hand_dir    = vec_sub(mid_knuckle, wrist)

    if side == 'Left':
        hand_right = vec_sub(idx, pnk)
        rest_fwd   = [-1, 0, 0]
    else:
        hand_right = vec_sub(pnk, idx)
        rest_fwd   = [1, 0, 0]

    q_hand_world = quat_from_frame_vecs(hand_dir, hand_right, rest_fwd, [0, 0, 1])
    q_hand_local = quat_mult(quat_inv(q_forearm_world), q_hand_world)
    rx, ry, rz   = quat_to_euler(q_hand_local)

    generic_bone = f'{side}Hand'
    set_rotation(scriptOp, generic_bone, rx, ry, rz, scriptOp.par.Handsmooth)
    return q_hand_world

