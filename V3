def _new_person_state():
    return {
        'prev_rot': {}, 'rotation_history': {}, '_euro_state': {},
        '_arm_pole_prev': {}, '_gate_prev': {}, '_ankle_prev': {},
        '_lm_state': {}, '_facing_prev': {}, '_limb_debug': {},
        '_bone_out_q': {}, '_lookahead_state': {}, '_bone_len': {}, '_bone_conf': {},
        '_legik': {'left':  {'L1': None, 'L2': None, 'prev': None, 'contact': False, 'pin': None,
                             'cN': 0, 'rN': 0, 'blend': 0.0, 'tsm': None},
                   'right': {'L1': None, 'L2': None, 'prev': None, 'contact': False, 'pin': None,
                             'cN': 0, 'rN': 0, 'blend': 0.0, 'tsm': None},
                   'floor': None},
        '_rootlife': {'phase': 0.0},
        '_root_pos_prev': None, '_stationary_n': 0, '_root_locked': None,
    }

def _bind_person_state(tag):
    """Point every per-person temporal global at this person's state (created on
    first use). Dicts bind by reference so in-place mutation persists; the three
    scalar globals are captured back by _capture_person_scalars after the pass."""
    global prev_rot, rotation_history, _euro_state, _arm_pole_prev, _gate_prev
    global _ankle_prev, _lm_state, _facing_prev, _limb_debug, _bone_out_q
    global _lookahead_state, _bone_len, _bone_conf, _legik, _rootlife
    global _root_pos_prev, _stationary_n, _root_locked
    st = _person_states.get(tag)
    if st is None:
        st = _new_person_state()
        _person_states[tag] = st
    prev_rot         = st['prev_rot'];         rotation_history = st['rotation_history']
    _euro_state      = st['_euro_state'];      _arm_pole_prev   = st['_arm_pole_prev']
    _gate_prev       = st['_gate_prev'];       _ankle_prev      = st['_ankle_prev']
    _lm_state        = st['_lm_state'];        _facing_prev     = st['_facing_prev']
    _limb_debug      = st['_limb_debug'];      _bone_out_q      = st['_bone_out_q']
    _lookahead_state = st['_lookahead_state']; _bone_len        = st['_bone_len']
    _bone_conf       = st['_bone_conf'];       _legik           = st['_legik']
    _rootlife        = st['_rootlife']
    _root_pos_prev   = st['_root_pos_prev']
    _stationary_n    = st['_stationary_n'];    _root_locked     = st['_root_locked']
    return st

def _capture_person_scalars(tag):
    """Read back the three scalar globals (reassigned by smooth_position /
    _finalize_root during the pass) into the person's stored state."""
    st = _person_states.get(tag)
    if st is None:
        return
    st['_root_pos_prev'] = _root_pos_prev
    st['_stationary_n']  = _stationary_n
    st['_root_locked']   = _root_locked

_PERSON_TOKEN_RE = re.compile(r'^(?:p|person|pose|body)[_\-:.]?(\d+)[_\-:.]+(.+)$')

def _person_split(base):
    """(person_id or None, landmark_base) from a lowercased pre-':axis' token.
    Recognises p0_/p1:/person_2-/pose3. No token -> single unnamed person.
    NOTE: this is the ONE place to adjust if your MediaPipe->CHOP naming differs
    (e.g. change the prefix alternation or numbering scheme)."""
    m = _PERSON_TOKEN_RE.match(base)
    if m:
        return int(m.group(1)), m.group(2)
    return None, base

def group_people_landmarks(scriptOp, mocap_in, flips, multi, maxp):
    """Split the mocap input into per-person landmark + inline-confidence dicts.
    Returns ordered [(tag, landmarks, conf), ...], tags p1..pN in ENCOUNTER order
    (independent of the input's own numbering). No person token -> single p1."""
    fx, fy, fz = flips
    raw_lm, raw_cf = {}, {}
    for ch in mocap_in.chans():
        nm = ch.name
        if ':' not in nm:
            continue
        base, suf = nm.rsplit(':', 1)
        base = base.lower().strip(); suf = suf.lower().strip()
        pid, lm = _person_split(base)
        if suf in ('x', 'y', 'z'):
            d = raw_lm.setdefault(pid, {})
            d.setdefault(lm, [0.0, 0.0, 0.0])['xyz'.index(suf)] = ch[0]
        elif suf in ('v', 'vis', 'visibility', 'conf', 'confidence', 'presence', 'p'):
            c = raw_cf.setdefault(pid, {})
            try:
                c[lm] = max(0.0, min(1.0, float(ch[0])))
            except Exception:
                pass
    if not raw_lm:
        return []
    pids = sorted(raw_lm.keys(), key=lambda k: (k is None, k))
    pids = pids[:1] if not multi else pids[:max(1, min(5, maxp))]
    out = []
    for i, pid in enumerate(pids):
        lmset = raw_lm.get(pid, {})
        for name in lmset:
            lmset[name] = transform_world_landmark(lmset[name], fx, fy, fz)
        out.append((f'p{i+1}', lmset, raw_cf.get(pid, {})))
    return out

def parse_hand_input_chop(chop, flips):
    """MediaPipe hand CHOP -> {idx: [x,y,z]} world, flips applied. Module-level
    version of the old nested parse_hand_input."""
    lms = {}
    if chop is None:
        return lms
    fx, fy, fz = flips
    tmp = {}
    for ch in chop.chans():
        idx, ax = _resolve_landmark_index(ch.name)
        if idx is None or ax is None:
            continue
        tmp.setdefault(idx, [0.0, 0.0, 0.0])['xyz'.index(ax)] = ch[0]
    for idx, pos in tmp.items():
        lms[idx] = transform_world_landmark(pos, fx, fy, fz)
    return lms

def _set_present(scriptOp, tag, val):
    """Write a person's p{n}_present flag (1 = solved this frame / 0 = absent)."""
    chan_map = scriptOp.storage.get('chan_map', {})
    c = f'{tag}_present'
    if c in chan_map:
        scriptOp[chan_map[c]][0] = val


# ─────────────────────────────────────────────────────────────────────────────
#  Math
# ─────────────────────────────────────────────────────────────────────────────

def vec_add(a,b):   return [a[0]+b[0], a[1]+b[1], a[2]+b[2]]
def vec_sub(a,b):   return [a[0]-b[0], a[1]-b[1], a[2]-b[2]]
def vec_scale(v,s): return [v[0]*s, v[1]*s, v[2]*s]
def vec_dot(a,b):   return a[0]*b[0]+a[1]*b[1]+a[2]*b[2]
def vec_len(v):     return math.sqrt(v[0]**2+v[1]**2+v[2]**2)
def vec_cross(a,b): return [a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0]]
def vec_norm(v):
    l = vec_len(v)
    return [0,0,0] if l < 1e-8 else [v[0]/l, v[1]/l, v[2]/l]

def transform_world_landmark(pos, flip_x=False, flip_y=False, flip_z=False):
    x, y, z = pos
    if flip_x: x = -x
    if flip_y: y = -y
    if flip_z: z = -z
    return [x, y, z]

def clamp_angle(a):
    while a >  180: a -= 360
    while a < -180: a += 360
    return a

def _finite(*vals):
    """True only if every value is a real, finite number (no NaN / inf)."""
    for v in vals:
        if v != v or v == float('inf') or v == float('-inf'):
            return False
    return True

def _heal_bone(generic_bone):
    """Drop a bone's stale smoothing state so it re-inits on the next good
    frame — clears a latched NaN that would otherwise make the limb vanish."""
    _euro_state.pop(generic_bone, None)
    prev_rot.pop(generic_bone, None)
    rotation_history.pop(generic_bone, None)

def clamp_rotation(generic_bone, rx, ry, rz):
    # NOTE: the forearm clamp was removed — the full-frame solve puts the elbow
    # bend on a different axis, so clamping rx here mangled the arm at certain
    # poses (the "wild at a certain rotation" bug).  Legs keep their limits.
    if generic_bone in ('LeftLeg', 'RightLeg'):
        rx = max(-170.0, min(10.0, rx))
        ry = max(-30.0,  min(30.0, ry))
        rz = max(-35.0,  min(35.0, rz))
    if generic_bone in ('LeftUpLeg', 'RightUpLeg'):
        ry = max(-60.0,  min(60.0, ry))
    return rx, ry, rz

def quat_mult(q1, q2):
    w1,x1,y1,z1 = q1;  w2,x2,y2,z2 = q2
    r = [w1*w2-x1*x2-y1*y2-z1*z2,
         w1*x2+x1*w2+y1*z2-z1*y2,
         w1*y2-x1*z2+y1*w2+z1*x2,
         w1*z2+x1*y2-y1*x2+z1*w2]
    mag = math.sqrt(r[0]**2+r[1]**2+r[2]**2+r[3]**2)
    return [1,0,0,0] if mag < 1e-8 else [x/mag for x in r]

def quat_norm(q):
    mag = math.sqrt(q[0]**2 + q[1]**2 + q[2]**2 + q[3]**2)
    return [1,0,0,0] if mag < 1e-8 else [x/mag for x in q]

def quat_inv(q):
    n = quat_norm(q)
    return [n[0], -n[1], -n[2], -n[3]]

def quat_slerp(q1, q2, t):
    dot = sum(q1[i]*q2[i] for i in range(4))
    if dot != dot:                       # NaN in either input → take q2 fresh
        return list(q2)
    if dot < 0.0: q2 = [-x for x in q2]; dot = -dot
    if dot > 0.9995:
        result = [q1[i]+t*(q2[i]-q1[i]) for i in range(4)]
        mag = math.sqrt(sum(x**2 for x in result))
        return list(q2) if mag < 1e-12 else [x/mag for x in result]
    theta_0 = math.acos(max(-1.0, min(1.0, dot)))
    sin_0 = math.sin(theta_0)
    if sin_0 < 1e-9:                      # degenerate → no safe interpolation
        return list(q2)
    theta = theta_0 * t
    s0 = math.cos(theta) - dot * math.sin(theta) / sin_0
    s1 = math.sin(theta) / sin_0
    return [s0*q1[i]+s1*q2[i] for i in range(4)]

def quat_from_two_vecs(v1, v2):
    v1=vec_norm(v1); v2=vec_norm(v2)
    if vec_len(v1)<0.001 or vec_len(v2)<0.001: return [1,0,0,0]
    d=vec_dot(v1,v2)
    if d>=0.9999: return [1,0,0,0]
    if d<=-0.9999:
        axis=vec_norm(vec_cross([1,0,0],v1))
        if vec_len(axis)<0.001: axis=vec_norm(vec_cross([0,1,0],v1))
        return [0,axis[0],axis[1],axis[2]]
    axis=vec_cross(v1,v2)
    s=math.sqrt((1+d)*2); invs=1.0/s
    return [s*0.5, axis[0]*invs, axis[1]*invs, axis[2]*invs]

def _quat_rotate_vec(q, v):
    w,x,y,z = q; vx,vy,vz = v
    tx = 2*(y*vz - z*vy)
    ty = 2*(z*vx - x*vz)
    tz = 2*(x*vy - y*vx)
    return [vx + w*tx + y*tz - z*ty,
            vy + w*ty + z*tx - x*tz,
            vz + w*tz + x*ty - y*tx]

def mat3_to_quat(m):
    trace = m[0][0]+m[1][1]+m[2][2]
    if trace > 0:
        s = 0.5/math.sqrt(trace+1.0)
        return [0.25/s, (m[2][1]-m[1][2])*s, (m[0][2]-m[2][0])*s, (m[1][0]-m[0][1])*s]
    elif m[0][0]>m[1][1] and m[0][0]>m[2][2]:
        s = 2.0*math.sqrt(1.0+m[0][0]-m[1][1]-m[2][2])
        return [(m[2][1]-m[1][2])/s, 0.25*s, (m[0][1]+m[1][0])/s, (m[0][2]+m[2][0])/s]
    elif m[1][1]>m[2][2]:
        s = 2.0*math.sqrt(1.0+m[1][1]-m[0][0]-m[2][2])
        return [(m[0][2]-m[2][0])/s, (m[0][1]+m[1][0])/s, 0.25*s, (m[1][2]+m[2][1])/s]
    else:
        s = 2.0*math.sqrt(1.0+m[2][2]-m[0][0]-m[1][1])
        return [(m[1][0]-m[0][1])/s, (m[0][2]+m[2][0])/s, (m[1][2]+m[2][1])/s, 0.25*s]

def quat_from_frame_vecs(primary_dir, secondary_dir, primary_rest, secondary_rest):
    fwd = vec_norm(primary_dir)
    up_raw = vec_sub(secondary_dir, vec_scale(fwd, vec_dot(secondary_dir, fwd)))
    up = vec_norm(up_raw)
    if vec_len(up) < 1e-6:
        up = vec_norm(vec_cross(fwd, [0,0,1] if abs(fwd[2])<0.9 else [1,0,0]))
    right = vec_norm(vec_cross(fwd, up))
    pr = vec_norm(primary_rest)
    sr_raw = vec_sub(secondary_rest, vec_scale(pr, vec_dot(secondary_rest, pr)))
    sr = vec_norm(sr_raw)
    rr = vec_norm(vec_cross(pr, sr))
    m = [
        [fwd[0]*pr[0]+right[0]*rr[0]+up[0]*sr[0], fwd[0]*pr[1]+right[0]*rr[1]+up[0]*sr[1], fwd[0]*pr[2]+right[0]*rr[2]+up[0]*sr[2]],
        [fwd[1]*pr[0]+right[1]*rr[0]+up[1]*sr[0], fwd[1]*pr[1]+right[1]*rr[1]+up[1]*sr[1], fwd[1]*pr[2]+right[1]*rr[2]+up[1]*sr[2]],
        [fwd[2]*pr[0]+right[2]*rr[0]+up[2]*sr[0], fwd[2]*pr[1]+right[2]*rr[1]+up[2]*sr[1], fwd[2]*pr[2]+right[2]*rr[2]+up[2]*sr[2]],
    ]
    q = mat3_to_quat(m)
    mag = math.sqrt(sum(x*x for x in q))
    return [1,0,0,0] if mag<1e-8 else [x/mag for x in q]

def quat_to_euler(q):
    w,x,y,z=q
    sinr=2*(w*x+y*z); cosr=1-2*(x*x+y*y)
    rx=math.atan2(sinr,cosr)
    sinp=2*(w*y-z*x)
    ry=math.copysign(math.pi/2,sinp) if abs(sinp)>=1 else math.asin(sinp)
    siny=2*(w*z+x*y); cosy=1-2*(y*y+z*z)
    rz=math.atan2(siny,cosy)
    return (math.degrees(rx), math.degrees(ry), math.degrees(rz))

def quat_to_euler_order(q, order='XYZ'):
    w,x,y,z=q
    m=[[1-2*(y*y+z*z),2*(x*y-w*z),2*(x*z+w*y)],
       [2*(x*y+w*z),1-2*(x*x+z*z),2*(y*z-w*x)],
       [2*(x*z-w*y),2*(y*z+w*x),1-2*(x*x+y*y)]]
    order=order.upper(); eps=1e-6
    if order=='XYZ':
        sy=max(-1.0,min(1.0,m[0][2])); ry=math.asin(sy)
        if abs(sy)<1-eps: rx=math.atan2(-m[1][2],m[2][2]); rz=math.atan2(-m[0][1],m[0][0])
        else: rx=math.atan2(m[2][1],m[1][1]); rz=0.0
    elif order=='XZY':
        sz=max(-1.0,min(1.0,-m[0][1])); rz=math.asin(sz)
        if abs(sz)<1-eps: rx=math.atan2(m[2][1],m[1][1]); ry=math.atan2(m[0][2],m[0][0])
        else: rx=math.atan2(-m[1][2],m[2][2]); ry=0.0
    elif order=='YXZ':
        sx=max(-1.0,min(1.0,-m[1][2])); rx=math.asin(sx)
        if abs(sx)<1-eps: ry=math.atan2(m[0][2],m[2][2]); rz=math.atan2(m[1][0],m[1][1])
        else: ry=math.atan2(-m[2][0],m[0][0]); rz=0.0
    elif order=='YZX':
        sz=max(-1.0,min(1.0,m[1][0])); rz=math.asin(sz)
        if abs(sz)<1-eps: ry=math.atan2(-m[2][0],m[0][0]); rx=math.atan2(-m[1][2],m[1][1])
        else: ry=math.atan2(m[0][2],m[2][2]); rx=0.0
    elif order=='ZXY':
        sx=max(-1.0,min(1.0,m[2][1])); rx=math.asin(sx)
        if abs(sx)<1-eps: rz=math.atan2(-m[0][1],m[1][1]); ry=math.atan2(-m[2][0],m[2][2])
        else: rz=math.atan2(m[1][0],m[0][0]); ry=0.0
    elif order=='ZYX':
        sy=max(-1.0,min(1.0,-m[2][0])); ry=math.asin(sy)
        if abs(sy)<1-eps: rz=math.atan2(m[1][0],m[0][0]); rx=math.atan2(m[2][1],m[2][2])
        else: rz=math.atan2(-m[0][1],m[1][1]); rx=0.0
    else: return quat_to_euler_order(q,'XYZ')
    return (math.degrees(rx), math.degrees(ry), math.degrees(rz))

def euler_to_quat(rx, ry, rz):
    rx,ry,rz=math.radians(rx),math.radians(ry),math.radians(rz)
    cr,sr=math.cos(rx*.5),math.sin(rx*.5)
    cp,sp=math.cos(ry*.5),math.sin(ry*.5)
    cy,sy=math.cos(rz*.5),math.sin(rz*.5)
    return [cr*cp*cy+sr*sp*sy, sr*cp*cy-cr*sp*sy, cr*sp*cy+sr*cp*sy, cr*cp*sy-sr*sp*cy]

# ── v2.9.11: turn-around continuity gate ─────────────────────────────────────
def gate_world_quat(key, q, max_deg, blend=0.2):
    """Reject implausible single-frame jumps in a world frame (turn-around pop /
    MediaPipe front-back flip). Eases toward the new frame instead of snapping.
    Sits BEFORE the solve; does not alter how a good frame is computed. Cannot
    fix a frame the tracker genuinely got wrong while back-facing."""
    q = quat_norm(q)
    prev = _gate_prev.get(key)
    if prev is None:
        _gate_prev[key] = list(q)
        return q
    d = sum(prev[i]*q[i] for i in range(4))
    if d < 0.0:
        q = [-x for x in q]; d = -d
    ang = math.degrees(2.0 * math.acos(max(-1.0, min(1.0, d))))
    out = quat_slerp(prev, q, blend) if ang > max_deg else q
    _gate_prev[key] = list(out)
    return out

# ── v2.9.12: confidence-weighted gate ────────────────────────────────────────
def parse_confidence(mocap_in):
    """Build {landmark_lower: 0..1} from any :v / :visibility / :confidence /
    :presence channels on the mocap input. Missing → treated as 1.0 downstream."""
    conf = {}
    for ch in mocap_in.chans():
        m = _CONF_RE.search(ch.name)
        if not m:
            continue
        name = ch.name[:m.start()].lower().strip()
        if name:
            try:
                conf[name] = max(0.0, min(1.0, float(ch[0])))
            except Exception:
                pass
    return conf

# ── v2.9.22: dedicated visibility / confidence CHOP ──────────────────────────
def _visibility_chop(scriptOp):
    """Resolve the dedicated visibility CHOP from the Visibilitychop path param.
    None when unset / not found -> fall back to inline :v channels on the mocap."""
    if hasattr(scriptOp.par, 'Visibilitychop'):
        p = scriptOp.par.Visibilitychop.eval()
        if p:
            o = op(p)
            if o is not None:
                return o
    return None

def parse_confidence_from_chop(chop):
    """Build {landmark_lower: 0..1} from a SEPARATE visibility/confidence CHOP
    (e.g. a Null holding one value per joint). Channel names may be bare
    landmarks ('left_elbow') or carry a :v / :visibility / :confidence /
    :presence suffix ('left_elbow:visibility') — either resolves to the landmark
    name the rest of the script uses. Missing joints -> treated as 1.0."""
    conf = {}
    if chop is None:
        return conf
    for ch in chop.chans():
        m = _CONF_RE.search(ch.name)
        name = (ch.name[:m.start()] if m else ch.name).lower().strip()
        name = name.rstrip(':_.-').strip()       # tolerate a bare trailing sep
        if not name:
            continue
        try:
            conf[name] = max(0.0, min(1.0, float(ch[0])))
        except Exception:
            pass
    return conf

def torso_confidence(conf):
    """Mean confidence of the four torso landmarks that build both world frames.
    1.0 when no :v channels exist (i.e. exact v2.9.11 behaviour)."""
    keys = ('left_shoulder', 'right_shoulder', 'left_hip', 'right_hip')
    vals = [conf[k] for k in keys if k in conf]
    return sum(vals) / len(vals) if vals else 1.0

def adaptive_gate(scriptOp, key, q, tconf):
    """Confidence-scaled wrapper around gate_world_quat. As torso confidence
    drops (side/back turn), the allowed per-frame jump shrinks and the ease-in
    blend lengthens, so bad frames can't snap the torso — they lag toward the
    last trusted frame instead. tconf=1.0 → identical to the plain gate."""
    base_max = scriptOp.par.Turngatemaxdeg.eval() if hasattr(scriptOp.par, 'Turngatemaxdeg') else 40.0
    floor_frac = scriptOp.par.Gateconffloor.eval() if hasattr(scriptOp.par, 'Gateconffloor') else 0.25
    c = max(0.0, min(1.0, tconf))
    scale = floor_frac + (1.0 - floor_frac) * c
    max_deg = base_max * scale
    blend = 0.2 + (1.0 - c) * 0.5          # 0.2 → 0.7 as confidence falls
    return gate_world_quat(key, q, max_deg, blend)

# ── v2.9.12: two-bone analytic IK (law of cosines) ───────────────────────────
def _two_bone_ik(R, T, L1, L2, pole):
    """R=root(hip), T=target(ankle), L1/L2=segment lengths, pole=knee-forward
    hint (world). Returns knee position K. Reach is clamped so a slightly-too-far
    target straightens instead of exploding."""
    to_t = vec_sub(T, R)
    d = vec_len(to_t)
    if d < 1e-6:
        return vec_add(R, vec_scale(vec_norm(pole), L1))
    d = max(abs(L1 - L2) + 1e-4, min(L1 + L2 - 1e-4, d))   # keep reachable
    n = vec_scale(to_t, 1.0 / vec_len(to_t))
    b = vec_sub(pole, vec_scale(n, vec_dot(pole, n)))      # pole ⊥ to hip→ankle
    if vec_len(b) < 1e-5:
        b = vec_cross(n, [1, 0, 0])
        if vec_len(b) < 1e-5:
            b = vec_cross(n, [0, 0, 1])
    b = vec_norm(b)
    cos_a = max(-1.0, min(1.0, (L1*L1 + d*d - L2*L2) / (2.0 * L1 * d)))
    a = math.acos(cos_a)
    return vec_add(R, vec_add(vec_scale(n, L1*math.cos(a)), vec_scale(b, L1*math.sin(a))))

# ─────────────────────────────────────────────────────────────────────────────
#  Smoothing  — One Euro filter (rotations) + exponential (position)
# ─────────────────────────────────────────────────────────────────────────────

def _euro_alpha(dt, cutoff):
    if cutoff <= 0.0: return 1.0
    tau = 1.0 / (2.0 * math.pi * cutoff)
    return 1.0 / (1.0 + tau / dt)

def smooth_quat(name, new_q, s, min_cutoff_override=None, beta_override=None):
    global _euro_state
    try:
        now = absTime.seconds
    except Exception:
        now = 0.0

    s = max(0.0, min(0.98, float(s)))
    if min_cutoff_override is not None:
        min_cutoff = max(0.01, float(min_cutoff_override))
    else:
        min_cutoff = 0.4 + (1.0 - s) * 6.0
    beta = float(beta_override) if beta_override is not None else EURO_BETA

    st = _euro_state.get(name)
    if st is None:
        _euro_state[name] = {'q': list(new_q), 'qprev': list(new_q),
                             'dspeed': 0.0, 't': now}
        return quat_to_euler(new_q)

    dt = now - st['t']
    if dt <= 0.0 or dt > 0.25: dt = DT_FALLBACK

    if sum(st['qprev'][i] * new_q[i] for i in range(4)) < 0.0:
        new_q = [-x for x in new_q]

    dq = quat_mult(new_q, quat_inv(st['qprev']))
    w = max(-1.0, min(1.0, dq[0]))
    angle = 2.0 * math.acos(w)
    if angle > math.pi: angle = 2.0 * math.pi - angle
    speed = angle / dt

    a_d = _euro_alpha(dt, 1.0)
    dspeed = a_d * speed + (1.0 - a_d) * st['dspeed']
    cutoff = min_cutoff + beta * dspeed
    # v2.9.21: confidence-driven smoothing. _bone_conf is populated per-cook only
    # when the toggle is on; a low-confidence bone gets a lower cutoff (heavier
    # smoothing) even while moving, since that motion may be tracker garbage.
    c = _bone_conf.get(name, 1.0)
    if c < 1.0:
        cutoff *= (_conf_smooth_floor + (1.0 - _conf_smooth_floor) * c)
    a = _euro_alpha(dt, cutoff)

    q_prev = st['q']
    if sum(q_prev[i] * new_q[i] for i in range(4)) < 0.0:
        q_prev = [-x for x in q_prev]
    q_hat = quat_slerp(q_prev, new_q, a)

    _euro_state[name] = {'q': q_hat, 'qprev': list(new_q),
                         'dspeed': dspeed, 't': now}
    return quat_to_euler(q_hat)


def smooth_position(new_pos, factor=0.5):
    """Simple exponential lag on root position. factor 0=instant, 0.95=heavy."""
    global _root_pos_prev
    if _root_pos_prev is None:
        _root_pos_prev = list(new_pos)
        return list(new_pos)
    alpha = max(0.0, min(0.98, factor))
    result = [
        _root_pos_prev[i] * alpha + new_pos[i] * (1.0 - alpha)
        for i in range(3)
    ]
    _root_pos_prev = result
    return result

# ── v2.9.11: root anchor (feet/ground) + foot lock (anti-drift) ──────────────
def _foot_ground_y(landmarks):
    """Lowest available foot/ankle world Y = ground contact. None if no feet.
    +Y up convention -> the grounded foot is the LOWEST y."""
    ys = [landmarks[k][1] for k in
          ('left_heel','left_ankle','left_foot_index',
           'right_heel','right_ankle','right_foot_index') if landmarks.get(k)]
    return min(ys) if ys else None

def _finalize_root(scriptOp, landmarks, pos):
    """Post-process the root translation only — rotation solve is untouched.
    Optional feet/ground Y anchor, then optional stationary hold (anti-drift)."""
    global _stationary_n, _root_locked

    # Feet / ground Y anchor
    if hasattr(scriptOp.par, 'Rootanchor') and scriptOp.par.Rootanchor.eval() == 'Feet':
        gy = _foot_ground_y(landmarks)
        if gy is not None:
            scale = scriptOp.par.Rootscale.eval() if hasattr(scriptOp.par, 'Rootscale') else 100.0
            off   = scriptOp.par.Rootgroundoffset.eval() if hasattr(scriptOp.par, 'Rootgroundoffset') else 0.0
            pos = [pos[0], gy * scale + off, pos[2]]

    # Foot lock: hold the root while the performer is standing still
    if hasattr(scriptOp.par, 'Footlock') and scriptOp.par.Footlock.eval():
        thr  = scriptOp.par.Footlockvel.eval() if hasattr(scriptOp.par, 'Footlockvel') else 0.01
        need = int(scriptOp.par.Footlockframes.eval()) if hasattr(scriptOp.par, 'Footlockframes') else 6
        moving = False
        for side in ('left', 'right'):
            cur  = landmarks.get(f'{side}_ankle')
            prev = _ankle_prev.get(side)
            if cur and prev and vec_len(vec_sub(cur, prev)) > thr:
                moving = True
            if cur:
                _ankle_prev[side] = list(cur)
        if moving:
            _stationary_n = 0
            _root_locked = None
        else:
            _stationary_n += 1
            if _stationary_n >= need:
                if _root_locked is None:
                    _root_locked = list(pos)
                pos = list(_root_locked)
    else:
        _stationary_n = 0
        _root_locked = None
    return pos

# ── v2.9.12: leg IK + ground contact, and root life ──────────────────────────
def reset_leg_ik():
    """Clear leg-IK/ground-contact state (called on Reset alongside the filters)."""
    for s in ('left', 'right'):
        _legik[s].update({'L1': None, 'L2': None, 'prev': None,
                          'contact': False, 'pin': None})
    _legik['floor'] = None
    _rootlife['phase'] = 0.0

def _update_floor(scriptOp, landmarks):
    """Floor level in landmark space. Manual mode reads a param; Adaptive tracks
    the lowest ankle Y (snap down instantly, relax up slowly so it follows a
    step-up over time)."""
    mode = scriptOp.par.Floormode.eval() if hasattr(scriptOp.par, 'Floormode') else 'Adaptive'
    if mode == 'Manual':
        _legik['floor'] = scriptOp.par.Floory.eval() if hasattr(scriptOp.par, 'Floory') else 0.0
        return _legik['floor']
    ys = [landmarks[k][1] for k in ('left_ankle', 'right_ankle') if landmarks.get(k)]
    if not ys:
        return _legik['floor']
    lo = min(ys)
    if _legik['floor'] is None:
        _legik['floor'] = lo
    else:
        _legik['floor'] = lo if lo < _legik['floor'] else _legik['floor'] * 0.995 + lo * 0.005
    return _legik['floor']

def apply_leg_ground_ik(scriptOp, landmarks):
    """Full leg + foot solve WITH additive IK ground contact. Runs in place of
    the section-9 FK leg/foot block only when Legik is ON.

    Per leg: capture rest segment lengths once (locks limb length), detect foot
    contact (near floor + low speed), pin the contact foot in place (anti-slide)
    and clamp any foot to >= floor (collision), re-solve the knee to reach that
    target, then SLERP-blend FK↔IK by Legikweight and write through set_rotation
    exactly like the FK path (so calibration / offsets / rord all still apply).
    Feet/toes use the original section-9 foot math, plus an optional flatten
    while the foot is planted."""
    weight    = scriptOp.par.Legikweight.eval() if hasattr(scriptOp.par, 'Legikweight') else 1.0
    ankle_off = scriptOp.par.Ankleoffset.eval() if hasattr(scriptOp.par, 'Ankleoffset') else 0.0
    band      = scriptOp.par.Contactband.eval() if hasattr(scriptOp.par, 'Contactband') else 0.06
    cvel      = scriptOp.par.Contactvel.eval() if hasattr(scriptOp.par, 'Contactvel') else 0.01
    pin_on    = scriptOp.par.Footpin.eval() if hasattr(scriptOp.par, 'Footpin') else True
    flatten   = scriptOp.par.Footflatten.eval() if hasattr(scriptOp.par, 'Footflatten') else 0.0

    floor = _update_floor(scriptOp, landmarks)
    w = max(0.0, min(1.0, weight))

    # knee bend-plane pole. MEASURED (default) uses the raw measured knee
    # direction (original) — but that direction IS the noisy monocular depth axis,
    # so it jitters / flips the knee when the legs face away or go near-straight.
    # FORWARD ignores the measured knee and bends the knee toward the body's own
    # forward direction (from the torso frame); the bend AMOUNT still comes from
    # the hip<->ankle distance in _two_bone_ik, so only reliable signals drive it.
    # BLEND mixes them. Kneepoleinvert flips forward if the knees hyperextend.
    _kpole_mode = scriptOp.par.Kneepole.eval() if hasattr(scriptOp.par, 'Kneepole') else 'MEASURED'
    _kpole_inv  = bool(scriptOp.par.Kneepoleinvert.eval()) if hasattr(scriptOp.par, 'Kneepoleinvert') else False
    _kpole_bl   = scriptOp.par.Kneepoleblend.eval() if hasattr(scriptOp.par, 'Kneepoleblend') else 0.5
    _body_fwd = None
    if _kpole_mode in ('FORWARD', 'BLEND'):
        _lh = landmarks.get('left_hip');      _rh = landmarks.get('right_hip')
        _ls = landmarks.get('left_shoulder'); _rs = landmarks.get('right_shoulder')
        if _lh and _rh and _ls and _rs:
            _hipr = vec_norm(vec_sub(_rh, _lh))
            _upv  = vec_norm(vec_sub(vec_scale(vec_add(_ls, _rs), 0.5),
                                     vec_scale(vec_add(_lh, _rh), 0.5)))
            _f = vec_cross(_upv, _hipr)
            if vec_len(_f) > 1e-6:
                _body_fwd = vec_norm(_f)
                if _kpole_inv:
                    _body_fwd = [-_body_fwd[0], -_body_fwd[1], -_body_fwd[2]]

    for side in ('left', 'right'):
        S = _legik[side]
        hip   = landmarks.get(f'{side}_hip')
        knee  = landmarks.get(f'{side}_knee')
        ankle = landmarks.get(f'{side}_ankle')
        upleg_bone = 'LeftUpLeg' if side == 'left' else 'RightUpLeg'
        leg_bone   = 'LeftLeg'   if side == 'left' else 'RightLeg'
        foot_bone  = 'LeftFoot'  if side == 'left' else 'RightFoot'
        toe_bone   = 'LeftToe'   if side == 'left' else 'RightToe'

        if not hip or not knee or not ankle:
            continue

        # FK reference (identical to section-9 math)
        fk_leg_dir  = vec_sub(knee, hip)
        q_ul_fk     = quat_from_two_vecs([0, -1, 0], fk_leg_dir)
        fk_calf_dir = vec_sub(ankle, knee)
        calf_local_fk = _quat_rotate_vec(quat_inv(q_ul_fk), fk_calf_dir)
        q_calf_fk   = quat_from_two_vecs([0, -1, 0], calf_local_fk)

        # lock rest segment lengths on the first good frame
        if S['L1'] is None:
            S['L1'] = max(1e-4, vec_len(fk_leg_dir))
            S['L2'] = max(1e-4, vec_len(fk_calf_dir))
        L1, L2 = S['L1'], S['L2']

        # contact detection (near floor + low ankle speed)
        speed = vec_len(vec_sub(ankle, S['prev'])) if S['prev'] else 0.0
        S['prev'] = list(ankle)
        near_floor = floor is not None and (ankle[1] - floor) < (band + ankle_off)
        contact = near_floor and speed < cvel

        # build IK target ankle position
        if contact and pin_on:
            if not S['contact'] or S['pin'] is None:            # contact onset → set pin
                S['pin'] = [ankle[0], (floor + ankle_off), ankle[2]]
            T = list(S['pin'])                                  # hold in place (anti-slide)
        else:
            S['pin'] = None
            y = ankle[1]
            if floor is not None and y < floor + ankle_off:     # collision: no penetration
                y = floor + ankle_off
            T = [ankle[0], y, ankle[2]]
        S['contact'] = contact

        # two-bone IK re-solve toward the target
        # knee bend-plane pole (see Kneepole block above)
        if _body_fwd is not None:
            _meas = vec_norm(vec_sub(knee, hip))
            if _kpole_mode == 'FORWARD' or vec_len(_meas) < 1e-6:
                pole = _body_fwd
            else:                                                  # BLEND
                pole = vec_norm([_meas[i] * (1.0 - _kpole_bl) + _body_fwd[i] * _kpole_bl
                                 for i in range(3)])
        else:
            pole = vec_sub(knee, hip)                              # measured (original)
        K = _two_bone_ik(hip, T, L1, L2, pole)
        ik_leg_dir  = vec_sub(K, hip)
        q_ul_ik     = quat_from_two_vecs([0, -1, 0], ik_leg_dir)
        ik_calf_dir = vec_sub(T, K)
        calf_local_ik = _quat_rotate_vec(quat_inv(q_ul_ik), ik_calf_dir)
        q_calf_ik   = quat_from_two_vecs([0, -1, 0], calf_local_ik)

        # blend FK↔IK (weight 0 → exact FK) and write
        q_ul   = quat_slerp(q_ul_fk,   q_ul_ik,   w)
        q_calf = quat_slerp(q_calf_fk, q_calf_ik, w)
        ux, uy, uz = quat_to_euler(q_ul)
        cx, cy, cz = quat_to_euler(q_calf)
        set_rotation(scriptOp, upleg_bone, ux, uy, uz, scriptOp.par.Rotationsmooth)
        set_rotation(scriptOp, leg_bone,   cx, cy, cz, scriptOp.par.Rotationsmooth)

        # world calf frame for the foot solve (blended upper * blended calf-local)
        q_leg_world = quat_mult(q_ul, q_calf)

        # foot + toe (section-9 foot math, plus optional flatten while planted)
        heel = landmarks.get(f'{side}_heel')
        toe  = landmarks.get(f'{side}_foot_index')
        if heel and toe:
            foot_fwd = vec_sub(toe, heel)
            foot_up  = vec_sub(ankle, heel)
            q_foot_world = quat_from_frame_vecs(foot_fwd, foot_up, [0, 0, -1], [0, 1, 0])
            q_foot_local = quat_mult(quat_inv(q_leg_world), q_foot_world)
            fx, fy, fz = quat_to_euler(q_foot_local)
            if contact and flatten > 0.0:            # settle the sole while planted
                fx *= (1.0 - flatten)
                fz *= (1.0 - flatten)
            set_rotation(scriptOp, foot_bone, fx, fy, fz, scriptOp.par.Rotationsmooth)

            toe_dir = vec_sub(toe, ankle)
            q_toe_world = quat_from_frame_vecs(toe_dir, foot_up, [0, 0, -1], [0, 1, 0])
            q_toe_local = quat_mult(quat_inv(q_foot_world), q_toe_world)
            tx, ty, tz = quat_to_euler(q_toe_local)
            set_rotation(scriptOp, toe_bone, tx, ty, tz, scriptOp.par.Rotationsmooth)

def apply_root_life(scriptOp, landmarks, pos):
    """Subtle procedural life on the root translation: a slow breath bob on Y and
    a small weight-shift toward the planted foot. Amounts default 0 → identity."""
    breath = scriptOp.par.Breathamt.eval() if hasattr(scriptOp.par, 'Breathamt') else 0.0
    shift  = scriptOp.par.Weightshiftamt.eval() if hasattr(scriptOp.par, 'Weightshiftamt') else 0.0
    if breath <= 0.0 and shift <= 0.0:
        return pos
    out = list(pos)
    if breath > 0.0:
        rate = scriptOp.par.Breathrate.eval() if hasattr(scriptOp.par, 'Breathrate') else 0.25
        _rootlife['phase'] += rate * DT_FALLBACK * 2.0 * math.pi
        out[1] += math.sin(_rootlife['phase']) * breath
    if shift > 0.0:
        rs = scriptOp.par.Rootscale.eval() if hasattr(scriptOp.par, 'Rootscale') else 100.0
        lc = _legik['left']['contact']; rc = _legik['right']['contact']
        la = landmarks.get('left_ankle'); ra = landmarks.get('right_ankle')
        if lc and not rc and la:
            out[0] += (la[0] * rs - out[0]) * shift
        elif rc and not lc and ra:
            out[0] += (ra[0] * rs - out[0]) * shift
    return out

# ── v2.9.13: side-view / turn robustness ─────────────────────────────────────
def reset_occlusion():
    """Clear occlusion-repair + facing-lock state (called on Reset)."""
    _lm_state.clear()
    _facing_prev.clear()

def repair_landmarks(scriptOp, landmarks, conf):
    """SIDE-VIEW / OCCLUSION REPAIR. When a landmark's MediaPipe visibility drops
    below the threshold (far-side limbs at profile, where MediaPipe hallucinates
    the occluded joint), don't let that garbage position drive the rig: COAST the
    landmark forward at its last good velocity for `Occlusioncoast` frames (a
    swinging limb keeps moving), then HOLD, until visibility recovers. Repairs
    POSITIONS in place, before the solve, so every downstream rotation — arms,
    legs, feet, leg IK — is fixed at once with zero change to the solve.

    Needs :v / :visibility channels on the mocap input. With none present every
    conf is 1.0 and this is a pure no-op. It CANNOT recover true occluded depth
    (single camera) — it stops garbage and bridges short occlusions; it does not
    invent truth, and long occlusions freeze rather than fabricate."""
    if not (hasattr(scriptOp.par, 'Occlusion') and scriptOp.par.Occlusion.eval()):
        return landmarks
    thr  = scriptOp.par.Occlusionconf.eval() if hasattr(scriptOp.par, 'Occlusionconf') else 0.5
    maxc = int(scriptOp.par.Occlusioncoast.eval()) if hasattr(scriptOp.par, 'Occlusioncoast') else 8
    maxc = max(1, maxc)
    try:    now = absTime.seconds
    except Exception: now = 0.0
    for name, pos in list(landmarks.items()):
        c  = conf.get(name, 1.0)
        st = _lm_state.get(name)
        if c >= thr or st is None:
            # good (or first) frame: record position + velocity, reset coast
            if st is not None:
                dt = now - st['t']
                if dt <= 0.0 or dt > 0.25:
                    dt = DT_FALLBACK
                v = [(pos[i] - st['p'][i]) / dt for i in range(3)]
            else:
                v = [0.0, 0.0, 0.0]
            _lm_state[name] = {'p': list(pos), 'v': v, 't': now, 'coast': 0}
        else:
            # occluded: coast at last velocity (decaying), then hold
            st['coast'] += 1
            if st['coast'] <= maxc:
                decay = max(0.0, 1.0 - st['coast'] / float(maxc))
                newp = [st['p'][i] + st['v'][i] * DT_FALLBACK * decay for i in range(3)]
            else:
                newp = list(st['p'])                    # hold last good position
            landmarks[name] = newp
            _lm_state[name] = {'p': newp, 'v': st['v'], 't': now, 'coast': st['coast']}
    return landmarks

def facing_lock(key, right_vec, hold_frames):
    """Reject a single-frame 180° flip of a torso right-vector — the near/far
    shoulder or hip swapping depth order at profile, which pops the chest to face
    backwards. A genuine turn reverses it for real, so a reversal SUSTAINED for
    `hold_frames` is accepted and released."""
    r = vec_norm(right_vec)
    if vec_len(r) < 1e-6:
        return right_vec
    prev = _facing_prev.get(key)
    if prev is None:
        _facing_prev[key] = (r, 0)
        return right_vec
    pv, flips = prev
    if vec_dot(r, pv) < 0.0:                             # reversed this frame
        flips += 1
        if flips < hold_frames:
            _facing_prev[key] = (pv, flips)              # hold previous facing
            return list(pv)
        _facing_prev[key] = (r, 0)                       # sustained → real turn
        return right_vec
    _facing_prev[key] = (r, 0)
    return right_vec

# -- Back-facing correction (additive, pre-solve, RGB best-effort) ------------
# MediaPipe loses its orientation cue (the face) when the back is to the camera
# and often reports a back-facing person AS front-facing: a coherent 180 deg
# error in Z + the L/R split. Face-landmark VISIBILITY is not corrupted by that
# flip, so we drive off it. When the face drops out AND the shoulder line did NOT
# reverse on its own (MediaPipe failed to turn), apply a 180 deg yaw about
# vertical to the body landmarks so the whole solve faces the right way, with no
# change to the solve itself. Needs face :v (nose/eyes/ears). No :v -> no-op
# (use Backfaceforce for a manual A/B on a known back clip). Body landmarks only;
# hand-CHOP data is untouched. Per-person via _active_person_prefix.
_facing_state = {}   # prefix -> {'fv':ema,'state':'front'/'back','ref':unit,'corr':bool}
FACE_LMS = ('nose', 'left_eye', 'right_eye', 'left_ear', 'right_ear')

def reset_facing():
    """Clear back-facing detection state (called on Reset)."""
    _facing_state.clear()

def _yaw180(p):
    return [-p[0], p[1], -p[2]]           # 180 deg about +Y (chirality preserved)

def facing_correct(scriptOp, landmarks, conf):
    """Detect a back-facing subject from face visibility and, when MediaPipe has
    reported it as front-facing (a coherent 180 flip), yaw the body landmarks
    180 about vertical BEFORE the solve. Additive; off by default."""
    if not (hasattr(scriptOp.par, 'Backfacefix') and scriptOp.par.Backfacefix.eval()):
        return landmarks
    st = _facing_state.setdefault(_active_person_prefix,
                                  {'fv': None, 'state': 'front', 'ref': None, 'corr': False})

    ls = landmarks.get('left_shoulder'); rs = landmarks.get('right_shoulder')
    cur_right = vec_norm(vec_sub(rs, ls)) if (ls and rs) else None

    # A/B override: force the correction (verify the geometry on a known back clip)
    if hasattr(scriptOp.par, 'Backfaceforce') and scriptOp.par.Backfaceforce.eval():
        st['corr'] = True
        return {k: _yaw180(v) for k, v in landmarks.items()}

    vis = [conf[k] for k in FACE_LMS if k in conf]
    if not vis:
        return landmarks                  # no face visibility -> cannot detect
    fv_raw = sum(vis) / len(vis)
    ema = scriptOp.par.Backfaceema.eval() if hasattr(scriptOp.par, 'Backfaceema') else 0.6
    st['fv'] = fv_raw if st['fv'] is None else st['fv'] * ema + fv_raw * (1.0 - ema)

    lo = scriptOp.par.Backfacevisthresh.eval() if hasattr(scriptOp.par, 'Backfacevisthresh') else 0.35
    hi = lo + (scriptOp.par.Backfacevishyst.eval() if hasattr(scriptOp.par, 'Backfacevishyst') else 0.15)

    if st['state'] == 'front':
        if cur_right is not None and vec_len(cur_right) > 1e-6:
            st['ref'] = cur_right          # keep a fresh front-facing reference
        if st['fv'] < lo:                  # just turned away
            reversed_ok = (st['ref'] is not None and cur_right is not None
                           and vec_dot(cur_right, st['ref']) < 0.0)
            st['corr'] = not reversed_ok   # correct ONLY if MediaPipe did not flip
            st['state'] = 'back'
            log(f'{_active_person_prefix or "p1"} back-facing (correct={st["corr"]})',
                'INFO', scriptOp)
    else:                                  # back
        if st['fv'] > hi:                  # face returned to view
            st['state'] = 'front'; st['corr'] = False
            log(f'{_active_person_prefix or "p1"} front-facing', 'INFO', scriptOp)

    if st['corr']:
        return {k: _yaw180(v) for k, v in landmarks.items()}
    return landmarks

# ── v2.9.17: predictive lookahead (latency cancel) ───────────────────────────
def reset_lookahead():
    """Clear lookahead velocity/accel state (called on Reset)."""
    _lookahead_state.clear()

def predict_landmarks(scriptOp, landmarks):
    """Extrapolate each body landmark forward by Lead Time using smoothed
    velocity (+ optional acceleration), so downstream One Euro can smooth hard
    without perceived lag. Runs AFTER occlusion repair — it predicts the cleaned
    signal. Adaptive damping shrinks the step when accel opposes velocity (a
    reversal / noise) so we don't fling past a stop; a hard per-component clamp
    caps overshoot from a bad velocity estimate. Lead = 0 → pure pass-through
    (state still primed), bit-identical to not calling it."""
    if not (hasattr(scriptOp.par, 'Lookahead') and scriptOp.par.Lookahead.eval()):
        return landmarks
    lead = (scriptOp.par.Leadms.eval() / 1000.0) if hasattr(scriptOp.par, 'Leadms') else 0.0
    vs   = max(0.0, min(0.95, scriptOp.par.Leadvelsmooth.eval())) if hasattr(scriptOp.par, 'Leadvelsmooth') else 0.6
    ua   = scriptOp.par.Leadaccel.eval() if hasattr(scriptOp.par, 'Leadaccel') else True
    mx   = scriptOp.par.Leadmaxstep.eval() if hasattr(scriptOp.par, 'Leadmaxstep') else 0.15
    edmp = max(0.0, min(1.0, scriptOp.par.Leaderraticdamp.eval())) if hasattr(scriptOp.par, 'Leaderraticdamp') else 1.0
    try:    now = absTime.seconds
    except Exception: now = 0.0

    for name, pos in landmarks.items():
        st = _lookahead_state.get(name)
        if st is None:
            _lookahead_state[name] = {'x': list(pos), 'v': [0.0, 0.0, 0.0],
                                      'a': [0.0, 0.0, 0.0], 't': now}
            continue
        dt = now - st['t']
        if dt <= 0.0 or dt > 0.25:
            dt = DT_FALLBACK
        newpos = list(pos)
        v_out = [0.0, 0.0, 0.0]; a_out = [0.0, 0.0, 0.0]
        for k in range(3):
            v_raw = (pos[k] - st['x'][k]) / dt
            v = vs * st['v'][k] + (1.0 - vs) * v_raw
            a = vs * st['a'][k] + (1.0 - vs) * ((v - st['v'][k]) / dt)
            v_out[k] = v; a_out[k] = a
            if lead <= 0.0:
                continue
            step = v * lead + (0.5 * a * lead * lead if ua else 0.0)
            if edmp > 0.0 and abs(v) > 1e-6:                # damp on reversal
                disagree = max(0.0, -((a * lead) * (1.0 if v >= 0 else -1.0)) / (abs(v) + 1e-6))
                step *= (1.0 - edmp * min(1.0, disagree))
            if step >  mx: step =  mx                       # overshoot clamp
            if step < -mx: step = -mx
            newpos[k] = pos[k] + step
        if lead > 0.0 and _finite(*newpos):
            landmarks[name] = newpos
        _lookahead_state[name] = {'x': list(pos), 'v': v_out, 'a': a_out, 't': now}
    return landmarks

# ── v2.9.21: bone-length depth fit (monocular depth recovery) ────────────────
def reset_bone_lengths():
    """Clear learned bone lengths (called on Reset and Re-Learn Bone Lengths)."""
    _bone_len.clear()

def _seg_conf(conf, a, b):
    """Confidence of a segment = min of its two endpoints (missing -> 1.0)."""
    return min(conf.get(a, 1.0), conf.get(b, 1.0))

def _learn_length(key, meas_len, seg_conf, thr, window):
    """Running median of high-confidence measured segment lengths = rest length.
    Median (not mean) so the odd stretched frame that slips past the confidence
    gate doesn't drag the estimate. Returns the current estimate or None."""
    st = _bone_len.get(key)
    if st is None:
        st = {'buf': [], 'L': None}
        _bone_len[key] = st
    if seg_conf >= thr and meas_len > 1e-5:
        buf = st['buf']
        buf.append(meas_len)
        if len(buf) > window:
            buf.pop(0)
        s = sorted(buf)
        st['L'] = s[len(s) // 2]
    return st['L']

def _depth_fit_child(parent, child, L, axis_idx, w):
    """Recover the depth-axis component of `child` from its trusted in-plane
    (screen) projection so the bone length equals L, then hard-lock the length.
    `w` lerps measured->corrected (0 = leave as measured). The whole point: keep
    the good X/Y, solve the noisy depth from geometry.

    If the in-plane offset alone already exceeds L (limb pointing across the
    screen longer than the bone — bad X/Y or a stale length), we can't satisfy it
    with depth, so we pull the joint in along the plane instead (depth 0), which
    degrades gracefully instead of NaN-ing on a negative sqrt."""
    d = vec_sub(child, parent)
    depth = d[axis_idx]
    planar = list(d); planar[axis_idx] = 0.0
    planar_len2 = vec_dot(planar, planar)
    L2 = L * L
    if planar_len2 <= L2:
        mag = math.sqrt(max(0.0, L2 - planar_len2))
        sign = 1.0 if depth >= 0.0 else -1.0        # keep measured depth side
        newd = list(planar); newd[axis_idx] = sign * mag
        target = vec_add(parent, newd)
    else:
        scale = L / math.sqrt(planar_len2)
        target = vec_add(parent, [planar[i] * scale for i in range(3)])
    out = [child[i] * (1.0 - w) + target[i] * w for i in range(3)]
    # hard length lock along the blended direction (kills residual stretch)
    dirv = vec_sub(out, parent); dl = vec_len(dirv)
    if dl > 1e-6:
        out = vec_add(parent, vec_scale(dirv, L / dl))
    if not _finite(*out):
        return child
    return out

def fit_bone_lengths(scriptOp, landmarks, conf):
    """Depth-fit each arm/leg chain from a trusted torso anchor outward. Learns
    rest lengths on the fly (high-confidence median), recovers depth from the
    in-plane projection, and confidence-weights the correction: a low-visibility
    joint is corrected MORE (its measured depth is least trustworthy). Off or
    strength 0 -> identity. MOCAP path only, before the solve."""
    if not (hasattr(scriptOp.par, 'Bonelengthfit') and scriptOp.par.Bonelengthfit.eval()):
        return landmarks
    strength = max(0.0, min(1.0, scriptOp.par.Bonelengthstrength.eval())) if hasattr(scriptOp.par, 'Bonelengthstrength') else 0.7
    floor    = max(0.0, min(1.0, scriptOp.par.Bonelengthfloor.eval()))    if hasattr(scriptOp.par, 'Bonelengthfloor')    else 0.3
    axis_ch  = scriptOp.par.Bonelengthdepthaxis.eval() if hasattr(scriptOp.par, 'Bonelengthdepthaxis') else 'Z'
    thr      = scriptOp.par.Bonelengthconf.eval()      if hasattr(scriptOp.par, 'Bonelengthconf')      else 0.6
    window   = int(scriptOp.par.Bonelengthwindow.eval()) if hasattr(scriptOp.par, 'Bonelengthwindow') else 30
    window   = max(3, window)
    axis_idx = {'X': 0, 'Y': 1, 'Z': 2}.get(axis_ch, 2)
    if strength <= 0.0:
        return landmarks

    for chain in BONE_LENGTH_CHAINS:
        parent_c = landmarks.get(chain[0])
        if not parent_c:
            continue
        parent_c = list(parent_c)                    # anchor kept as measured
        for i in range(1, len(chain)):
            pkey, ckey = chain[i - 1], chain[i]
            child = landmarks.get(ckey)
            if not child:
                break
            meas_len = vec_len(vec_sub(child, parent_c))
            sc = _seg_conf(conf, pkey, ckey)
            L  = _learn_length((pkey, ckey), meas_len, sc, thr, window)
            if L is None or L <= 1e-5:               # no estimate yet -> pass through
                parent_c = list(child)
                continue
            # low confidence -> correct more; full confidence -> only `floor`
            w = strength * (1.0 - (1.0 - floor) * sc)
            w = max(0.0, min(1.0, w))
            newchild = _depth_fit_child(parent_c, child, L, axis_idx, w)
            landmarks[ckey] = newchild
            parent_c = newchild
    return landmarks

# ── v2.9.19: arm anti-clip (torso capsule pushout) ───────────────────────────
def _push_out_capsule(pt, a, b, side, fwd, R, dr, strength, side_sign):
    """Push a point OUT of an elliptical capsule (axis a->b, radius R side / R*dr
    front) to its surface, blended by strength. Point outside -> returned as-is.
    On-axis degeneracy -> pushed to this arm's own side. Only DIRECTION matters
    downstream (the arm solve normalises), so distorting limb length here is fine
    — that's the whole trick: bend the arm's aim outward without moving anything
    that isn't clipping."""
    ab = vec_sub(b, a); L2 = vec_dot(ab, ab)
    t = 0.0 if L2 < 1e-9 else max(0.0, min(1.0, vec_dot(vec_sub(pt, a), ab) / L2))
    axis_pt = vec_add(a, vec_scale(ab, t))
    radial = vec_sub(pt, axis_pt)
    s = vec_dot(radial, side); f = vec_dot(radial, fwd)
    Rf = max(1e-6, R * dr)
    if R < 1e-6:
        return pt
    d = math.sqrt((s / R) ** 2 + (f / Rf) ** 2)     # elliptical distance (1 = surface)
    if d >= 1.0:
        return pt                                    # outside -> leave it
    if d < 1e-4:                                      # on the spine axis: bias to own side
        s = side_sign * R * 0.5; f = 0.0
        d = math.sqrt((s / R) ** 2 + (f / Rf) ** 2)
    scale = 1.0 / max(1e-6, d)                        # scale radial out to the surface
    target = vec_add(axis_pt, vec_add(vec_scale(side, s * scale), vec_scale(fwd, f * scale)))
    if not _finite(*target):
        return pt
    return [pt[i] * (1.0 - strength) + target[i] * strength for i in range(3)]

def _capsule_ellip_dist(pt, a, b, side, fwd, R, dr):
    """Elliptical distance of `pt` from the capsule axis a->b, in the SAME metric
    _push_out_capsule uses: 1.0 = on the surface, <1.0 = inside, >1.0 = outside.
    Lets us sample a bone SEGMENT and find its deepest-penetrating point without
    moving anything."""
    ab = vec_sub(b, a); L2 = vec_dot(ab, ab)
    t = 0.0 if L2 < 1e-9 else max(0.0, min(1.0, vec_dot(vec_sub(pt, a), ab) / L2))
    axis_pt = vec_add(a, vec_scale(ab, t))
    radial = vec_sub(pt, axis_pt)
    s = vec_dot(radial, side); f = vec_dot(radial, fwd)
    Rf = max(1e-6, R * dr)
    if R < 1e-6:
        return 1e9
    return math.sqrt((s / R) ** 2 + (f / Rf) ** 2)

def _clear_segment(landmarks, near_key, far_key, a, b, side, fwd, R, dr,
                   strength, side_sign, samples=5, iters=3):
    """Clear the BONE between two landmarks from the capsule, not just its ends.
    The near end is the pivot (it's already been endpoint-pushed and stays put);
    we sample along near->far, find the deepest interior sample, push THAT point
    to the surface, and move the FAR landmark by the same displacement scaled up
    by 1/t (so a mid-bone penetration swings the far end out enough to lift the
    whole span off the torso). Iterated to converge, since moving the far end
    re-shapes the segment. Only direction matters downstream, so the limb-length
    distortion this introduces is harmless — it just re-aims the bone outward."""
    near = landmarks.get(near_key); far = landmarks.get(far_key)
    if not near or not far or samples < 2:
        return
    for _ in range(max(1, iters)):
        seg = vec_sub(far, near)
        worst_d = 1e9; worst_t = None; worst_pt = None
        # sample interior points (skip the two endpoints: 0 and 1)
        for k in range(1, samples):
            t = k / float(samples)
            p = vec_add(near, vec_scale(seg, t))
            d = _capsule_ellip_dist(p, a, b, side, fwd, R, dr)
            if d < worst_d:
                worst_d = d; worst_t = t; worst_pt = p
        if worst_pt is None or worst_d >= 1.0:
            return                                   # whole span already clear
        pushed = _push_out_capsule(worst_pt, a, b, side, fwd, R, dr, strength, side_sign)
        delta = vec_sub(pushed, worst_pt)
        if vec_len(delta) < 1e-7:
            return
        # move the far end so the sampled point lands on `pushed` (lever 1/t)
        newfar = vec_add(far, vec_scale(delta, 1.0 / max(1e-3, worst_t)))
        if not _finite(*newfar):
            return
        far = newfar
    landmarks[far_key] = far

def anti_clip_arms(scriptOp, landmarks):
    """Keep arms from clipping the torso mesh: model the torso as an elliptical
    capsule (pelvis->chest, extended a little above the shoulders) and push any
    elbow/wrist landmark that's inside it out to the surface, BEFORE the solve.
    Additive — joints outside the capsule are untouched, so wide/relaxed poses
    are unchanged. Off (default) or radius 0 -> identity. MOCAP path only."""
    if not (hasattr(scriptOp.par, 'Armanticlip') and scriptOp.par.Armanticlip.eval()):
        return landmarks
    R        = scriptOp.par.Anticlipradius.eval()    if hasattr(scriptOp.par, 'Anticlipradius')    else 0.15
    dr       = scriptOp.par.Anticlipdepthratio.eval()if hasattr(scriptOp.par, 'Anticlipdepthratio')else 0.75
    margin   = scriptOp.par.Anticlipmargin.eval()    if hasattr(scriptOp.par, 'Anticlipmargin')    else 0.02
    strength = max(0.0, min(1.0, scriptOp.par.Anticlipstrength.eval())) if hasattr(scriptOp.par, 'Anticlipstrength') else 1.0
    topext   = scriptOp.par.Anticliptopext.eval()    if hasattr(scriptOp.par, 'Anticliptopext')    else 0.15
    if R <= 0.0 or strength <= 0.0:
        return landmarks

    lh = landmarks.get('left_hip');      rh = landmarks.get('right_hip')
    ls = landmarks.get('left_shoulder'); rs = landmarks.get('right_shoulder')
    if not (lh and rh and ls and rs):
        return landmarks

    a = vec_scale(vec_add(lh, rh), 0.5)              # capsule bottom (pelvis)
    top = vec_scale(vec_add(ls, rs), 0.5)            # chest
    axis = vec_sub(top, a)
    b = vec_add(top, vec_scale(axis, topext))        # extend above shoulders for high crossings
    side = vec_norm(vec_sub(rs, ls))                 # shoulder line
    up   = vec_norm(vec_sub(b, a))
    fwd  = vec_norm(vec_cross(up, side))             # torso forward normal
    if vec_len(side) < 1e-6 or vec_len(fwd) < 1e-6:
        return landmarks
    Reff = R + margin

    # v2.9.20 extra params (default to v2.9.19 behaviour when the toggles are off)
    do_fore = scriptOp.par.Anticlipforearm.eval() if hasattr(scriptOp.par, 'Anticlipforearm') else True
    do_hand = scriptOp.par.Anticliphand.eval()    if hasattr(scriptOp.par, 'Anticliphand')    else False
    samples = int(scriptOp.par.Anticlipsamples.eval()) if hasattr(scriptOp.par, 'Anticlipsamples') else 5
    samples = max(2, samples)

    # ── 1. Endpoint pushout (elbow + wrist, and hand endpoints if hands on) ──
    endpoints = [('left_elbow', -1.0), ('left_wrist', -1.0),
                 ('right_elbow', 1.0), ('right_wrist', 1.0)]
    if do_hand:
        endpoints += [('left_index', -1.0), ('left_pinky', -1.0),
                      ('right_index', 1.0), ('right_pinky', 1.0)]
    for key, sgn in endpoints:
        pt = landmarks.get(key)
        if pt:
            landmarks[key] = _push_out_capsule(pt, a, b, side, fwd, Reff, dr, strength, sgn)

    # ── 2. Forearm SEGMENT clear (elbow->wrist). The elbow is the pivot; the
    # wrist swings out so the whole forearm bone clears (fixes crossed arms).
    # Carry the wrist's displacement onto the pose hand landmarks so the hand
    # rides along with the moved wrist before its own segment clear below.
    if do_fore:
        for side_name, sgn in (('left', -1.0), ('right', 1.0)):
            wkey = f'{side_name}_wrist'
            w_before = list(landmarks[wkey]) if landmarks.get(wkey) else None
            _clear_segment(landmarks, f'{side_name}_elbow', wkey,
                           a, b, side, fwd, Reff, dr, strength, sgn, samples)
            if w_before is not None and landmarks.get(wkey):
                wd = vec_sub(landmarks[wkey], w_before)
                if vec_len(wd) > 1e-7:
                    for hk in (f'{side_name}_index', f'{side_name}_pinky'):
                        if landmarks.get(hk):
                            np = vec_add(landmarks[hk], wd)
                            if _finite(*np):
                                landmarks[hk] = np

    # ── 3. Hand SEGMENT clear (wrist->index and wrist->pinky). Wrist is the
    # pivot; the finger-base landmarks swing out so the hand span clears too.
    if do_hand:
        for side_name, sgn in (('left', -1.0), ('right', 1.0)):
            for far in (f'{side_name}_index', f'{side_name}_pinky'):
                _clear_segment(landmarks, f'{side_name}_wrist', far,
                               a, b, side, fwd, Reff, dr, strength, sgn, samples)
    return landmarks

# ── v2.9.11: angle-based (Kalidokit-style) finger curl solve ─────────────────
def _joint_flex_deg(a, b, c):
    """Flexion at joint b = 180 - interior angle between (a-b) and (c-b).
    0 when the two segments are straight, increasing as the joint curls."""
    v1 = vec_norm(vec_sub(a, b)); v2 = vec_norm(vec_sub(c, b))
    if vec_len(v1) < 1e-6 or vec_len(v2) < 1e-6:
        return 0.0
    d = max(-1.0, min(1.0, vec_dot(v1, v2)))
    return 180.0 - math.degrees(math.acos(d))

def _spread_axis(curl_axis):
    """A sane perpendicular axis for MCP spread given the curl axis."""
    return {'X': 'Y', 'Y': 'Z', 'Z': 'Y'}.get(curl_axis, 'Y')

def _finger_euler(axis, curl_deg, spread_axis=None, spread_deg=0.0):
    e = {'X': 0.0, 'Y': 0.0, 'Z': 0.0}
    e[axis] = e[axis] + curl_deg
    if spread_axis and spread_deg:
        e[spread_axis] = e[spread_axis] + spread_deg
    return e['X'], e['Y'], e['Z']

def _solve_fingers_curl(scriptOp, hand_lms, side):
    """Kalidokit principle: each joint's bend is angle(parent, joint, child)
    driven onto ONE curl axis (pure hinge, robust to depth noise). Proximal =
    angle(wrist, mcp, pip); intermediate = angle(mcp, pip, dip); distal =
    angle(pip, dip, tip). Optional MCP spread; thumb on its own axis."""
    wrist = hand_lms.get(0)
    if not wrist:
        return
    caxis = scriptOp.par.Fingercurlaxis.eval() if hasattr(scriptOp.par, 'Fingercurlaxis') else 'Z'
    csign = float(scriptOp.par.Fingercurlsign.eval()) if hasattr(scriptOp.par, 'Fingercurlsign') else -1.0
    taxis = scriptOp.par.Thumbcurlaxis.eval() if hasattr(scriptOp.par, 'Thumbcurlaxis') else 'Z'
    tsign = float(scriptOp.par.Thumbcurlsign.eval()) if hasattr(scriptOp.par, 'Thumbcurlsign') else -1.0
    spread_amt = scriptOp.par.Fingerspreadamt.eval() if hasattr(scriptOp.par, 'Fingerspreadamt') else 0.0

    # palm frame for optional MCP spread
    mid_mcp = hand_lms.get(9); idx_mcp = hand_lms.get(5); pnk_mcp = hand_lms.get(17)
    palm_fwd = vec_norm(vec_sub(mid_mcp, wrist)) if mid_mcp else None
    palm_nrm = None
    if idx_mcp and pnk_mcp and palm_fwd:
        right = vec_sub(idx_mcp, pnk_mcp) if side == 'Left' else vec_sub(pnk_mcp, idx_mcp)
        palm_nrm = vec_norm(vec_cross(palm_fwd, right))

    for finger, idxs in FINGER_MP_INDICES.items():
        is_thumb = (finger == 'Thumb')
        axis = taxis if is_thumb else caxis
        sign = tsign if is_thumb else csign
        bp = f'{side}Hand{finger}'
        mcp = hand_lms.get(idxs['mcp']); pip = hand_lms.get(idxs['pip'])
        dip = hand_lms.get(idxs['dip']); tip = hand_lms.get(idxs['tip'])
        if not mcp or not pip:
            continue

        prox_flex = _joint_flex_deg(wrist, mcp, pip)
        spread = 0.0
        if spread_amt and not is_thumb and palm_fwd and palm_nrm:
            seg = vec_sub(pip, mcp)
            in_plane = vec_sub(seg, vec_scale(palm_nrm, vec_dot(seg, palm_nrm)))
            in_plane = vec_norm(in_plane)
            if vec_len(in_plane) > 1e-6:
                s = vec_dot(vec_cross(palm_fwd, in_plane), palm_nrm)
                c = vec_dot(palm_fwd, in_plane)
                spread = math.degrees(math.atan2(s, c)) * spread_amt
        rx, ry, rz = _finger_euler(axis, sign * prox_flex, _spread_axis(axis), spread)
        set_rotation(scriptOp, f'{bp}1', rx, ry, rz, scriptOp.par.Handsmooth)

        if pip and dip:
            inter_flex = _joint_flex_deg(mcp, pip, dip)
            rx, ry, rz = _finger_euler(axis, sign * inter_flex)
            set_rotation(scriptOp, f'{bp}2', rx, ry, rz, scriptOp.par.Handsmooth)
            if tip:
                dist_flex = _joint_flex_deg(pip, dip, tip)
                rx, ry, rz = _finger_euler(axis, sign * dist_flex)
                set_rotation(scriptOp, f'{bp}3', rx, ry, rz, scriptOp.par.Handsmooth)

