def _save_custom_pars(scriptOp):
    saved = {}
    try:
        for p in scriptOp.customPars:
            info = {'val': p.eval()}
            try:
                mode = p.mode
                info['mode'] = mode
                if str(mode) == 'ParMode.EXPRESSION':
                    info['expr'] = p.expr
                elif str(mode) == 'ParMode.BIND':
                    info['bindExpr'] = p.bindExpr
            except:
                pass
            saved[p.name] = info
    except:
        pass
    return saved

def _restore_custom_pars(scriptOp, saved):
    for name, info in saved.items():
        if not hasattr(scriptOp.par, name):
            continue
        p = getattr(scriptOp.par, name)
        try:
            mode = info.get('mode')
            if mode and str(mode) == 'ParMode.EXPRESSION' and 'expr' in info:
                p.expr = info['expr']
            elif mode and str(mode) == 'ParMode.BIND' and 'bindExpr' in info:
                p.bindExpr = info['bindExpr']
            else:
                p.val = info['val']
        except:
            try:
                p.val = info['val']
            except:
                pass

