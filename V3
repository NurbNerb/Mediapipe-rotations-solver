# ── Hand-landmark channel-name normalisation ──────────────────────────────────
# Maps MediaPipe hand landmark NAMES (alnum-normalised) to the 0-20 index.
# Bare/prefixed integers are handled separately in _resolve_landmark_index.
_HAND_NAME_TO_IDX = {
    'wrist': 0,
    'thumbcmc': 1, 'thumbmcp': 2, 'thumbip': 3, 'thumbtip': 4,
    'indexfingermcp': 5, 'indexmcp': 5, 'indexfingerpip': 6, 'indexpip': 6,
    'indexfingerdip': 7, 'indexdip': 7, 'indexfingertip': 8, 'indextip': 8,
    'middlefingermcp': 9,  'middlemcp': 9,  'middlefingerpip': 10, 'middlepip': 10,
    'middlefingerdip': 11, 'middledip': 11, 'middlefingertip': 12, 'middletip': 12,
    'ringfingermcp': 13, 'ringmcp': 13, 'ringfingerpip': 14, 'ringpip': 14,
    'ringfingerdip': 15, 'ringdip': 15, 'ringfingertip': 16, 'ringtip': 16,
    'pinkymcp': 17, 'pinkypip': 18, 'pinkydip': 19, 'pinkytip': 20,
    'littlemcp': 17, 'littlepip': 18, 'littledip': 19, 'littletip': 20,
}

# Axis at the end of a channel name, after a separator or a leading 't'
# (matches :x  _x  .x  -x  :tx  _tx …).
_HAND_AXIS_RE = re.compile(r'[:_.\-]?(?:t)?([xyz])$', re.IGNORECASE)

def _resolve_landmark_index(name):
    """
    Channel name -> (landmark_index 0-20, axis 'x'/'y'/'z'), or (None, None).
    Accepts '0:x', '5:tx', 'landmark_0_x', 'hand0:x', 'wrist:x',
    'index_finger_tip:y', 'PINKY_MCP:z', etc.
    """
    m = _HAND_AXIS_RE.search(name)
    if not m:
        return None, None
    axis  = m.group(1).lower()
    token = name[:m.start()].lower()
    # strip a leading hand-index prefix like 'h1:', 'h2:', 'hand1_', 'left:' …
    token = re.sub(r'^\s*(?:h(?:and)?\d+|left|right|l|r)[:_.\-]', '', token)
    token = re.sub(r'[^a-z0-9]', '', token)
    if not token:
        return None, None
    if re.fullmatch(r'[a-z]*\d+', token):        # bare or prefixed integer
        return int(re.search(r'\d+$', token).group(0)), axis
    idx = _HAND_NAME_TO_IDX.get(token)
    return (idx, axis) if idx is not None else (None, None)

def _hand_chop(scriptOp, par_name, input_idx):
    """Resolve a hand CHOP: explicit path param first, then wired input."""
    if hasattr(scriptOp.par, par_name):
        p = getattr(scriptOp.par, par_name).eval()
        if p:
            o = op(p)
            if o is not None:
                return o
    if len(scriptOp.inputs) > input_idx and scriptOp.inputs[input_idx] is not None:
        return scriptOp.inputs[input_idx]
    return None

